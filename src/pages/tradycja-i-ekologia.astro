      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .trd [data-ryc="r"].in {
      animation: trdRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }

    /* diagram: kaskada warstw → strzałka scaleX → groty (delaye 1:1
       z eksportu; transitions zamiast keyframes — freeze-friendly) */
    html.js-motion .trd [data-diag] .dg-lay {
      opacity: 0;
      transform: translateY(9px);
      transition:
        opacity 0.62s cubic-bezier(0.22, 0.6, 0.2, 1),
        transform 0.62s cubic-bezier(0.22, 0.6, 0.2, 1);
    }
    html.js-motion .trd [data-diag] .dg-lay:nth-of-type(2) {
      transition-delay: 0.08s;
    }
    html.js-motion .trd [data-diag] .dg-lay:nth-of-type(3) {
      transition-delay: 0.16s;
    }
    html.js-motion .trd [data-diag] .dg-lay:nth-of-type(4) {
      transition-delay: 0.24s;
    }
    html.js-motion .trd [data-diag] .dg-lay:nth-of-type(5) {
