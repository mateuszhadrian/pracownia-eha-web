  /* gradienty masek „rysowania" (eksport: klin 105°/255° + smugi) */
  .trd {
    --ryc-wedge-l: linear-gradient(105deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-l: linear-gradient(
