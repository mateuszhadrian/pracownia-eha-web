    html.js-motion .trd [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .trd [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
