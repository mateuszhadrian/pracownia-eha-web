  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna i kompletna). Mobile: reveale +
     rysowanie rycin maską + parallaxy + DIAGRAM/KOLEK (transitions —
     analiza §2.8: freeze.css sadza stany końcowe natychmiast po `.in`);
     desktop: rysowanie [data-rycsb] + dryf tła. Wzorce i wartości 1:1
     z 4.2/4.3/4.4. ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .trd [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .trd [data-rev].in {
      opacity: 1;
      transform: none;
