      transition: transform 0.9s cubic-bezier(0.3, 0.05, 0.25, 1) 0.42s;
    }
    html.js-motion .trd [data-diag] .dg-arwh {
      opacity: 0;
      transition: opacity 0.4s ease 1.3s;
    }
    html.js-motion .trd [data-diag].in .dg-lay {
      opacity: 1;
      transform: none;
    }
    html.js-motion .trd [data-diag].in .dg-arw {
      transform: scaleX(1);
    }
    html.js-motion .trd [data-diag].in .dg-arwh {
      opacity: 1;
    }

    /* kolek: wjazd znaku wodnego (eksport: kolekIn 2.2 s) */
    html.js-motion .trd [data-kolek] {
      opacity: 0;
      transform: translate(-50%, 10px) scale(0.965);
      transition:
        opacity 2.2s cubic-bezier(0.22, 0.6, 0.2, 1),
        transform 2.2s cubic-bezier(0.22, 0.6, 0.2, 1);
    }
    html.js-motion .trd [data-kolek].in {
      opacity: 0.14;
      transform: translate(-50%, 0) scale(1);
    }
