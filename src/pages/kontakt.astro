  /* ── ryciny (pozycje z eksportu; mobile Z ALFĄ, desktop spłaszczone) ── */
  .kt-ryc {
    position: absolute;
    max-width: none;
    height: auto;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .kt-write-ryc {
    right: -30px;
    top: 48px;
    width: 150px;
    opacity: 0.4;
