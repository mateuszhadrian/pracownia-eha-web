  .kt-social-ryc {
    right: -44px;
    top: -10px;
    width: 168px;
    opacity: 0.4;
  }
  /* ODBICIE LUSTRZANE — TYLKO wariant mobilny (korekta sesji poprawek,
     zgłoszenie Mateusza). Rycina wystaje 44 px poza prawą krawędź
     (168 px szerokości, `right: -44px`), a `.kt-social` ma
     `overflow: hidden`, więc ekran ucinał prawe ~26 % rysunku — czyli
     dokładnie GŁOWĘ z dziobem i listem. Po odbiciu gołąb leci w lewo:
     głowa ląduje w okolicy x ≈ 269–299 px (bezpiecznie w kadrze),
     a poza krawędź wychodzi rozłożyste skrzydło, które cięcie znosi bez
     szkody. Kompozycja i kotwiczenie BEZ ZMIAN — odbijamy rysunek, nie
     ruszamy pozycji.
     Selektor MUSI mieć `.mOnly`: `.kt-social-ryc` to klasa WSPÓLNA obu
     wariantów, a reguła desktopowa nadpisuje tylko right/top/width —
     bez zawężenia odbicie łapało też rycinę desktopową (złapane
     kontraktem e2e przy pierwszym podejściu). */
  .kt-social-ryc.mOnly {
    transform: scaleX(-1);
  }
  @media (min-width: 1024px) {
    .kt-hero-ryc {
      right: clamp(30px, 4vw, 80px);
      top: auto;
      bottom: calc(-1 * clamp(20px, 2.4vw, 44px));
      width: clamp(280px, 24vw, 370px);
      /* wariant spłaszczony na biel: invert + screen neutralizuje tło
         na ciemnym hero (wzorzec HomeKontakt) */
      mix-blend-mode: screen;
    }
    .kt-write-ryc {
      right: clamp(4px, 1vw, 18px);
      top: calc(-1 * clamp(6px, 0.8vw, 14px));
      width: clamp(160px, 14vw, 220px);
    }
    .kt-area-ryc {
      right: -40px;
      bottom: -16px;
      width: clamp(130px, 12vw, 190px);
    }
    .kt-social-ryc {
      right: 0;
      top: clamp(6px, 1vw, 20px);
      width: clamp(170px, 15vw, 240px);
    }

    /* ── Ryciny desktopowe NIE mogą być ucinane od DOŁU (korekta sesji
       poprawek, zgłoszenie Mateusza). Przyczyna: `.kt-write`
       i `.kt-social` mają `overflow: hidden`, a ryciny są od nich
       WYŻSZE — zmierzone na trzech szerokościach: kałamarz 254–292 px
       w sekcji 142–164 px (wystaje 101–114 px), gołąb 272–318 px
       w sekcji 211–245 px (wystaje 75–94 px). Poziomą krawędzią cięcia
       kończył się rysunek w pół kreski.
       `overflow: hidden` zostaje potrzebny na MOBILE (tam ryciny celowo
       wychodzą za krawędź EKRANU — patrz komentarz przy szerokościach
       kontenerów), a na desktopie żadna nie wystaje w bok: kałamarz ma
       `right: clamp(4px,1vw,18px)`, gołąb `right: 0`. Zwalniamy więc
       wyłącznie oś PIONOWĄ. Para `overflow-x: clip` + `overflow-y:
       visible` jest tu obowiązkowa: przy `overflow-x: hidden`
       przeglądarka i tak podmieniłaby `visible` na `auto` i zrobiła ze
       sekcji scroller (`clip` tego nie wymusza). ── */
    .kt-write,
    .kt-social {
      overflow-x: clip;
      overflow-y: visible;
    }
    /* Kałamarz ma się CHOWAĆ ZA pudłem formularza (decyzja Mateusza),
       a nie leżeć na nim: `.kt-formsec` był `position: static`, więc
       jego tło malowało się w warstwie tła bloków — POD absolutną
       ryciną. Po nadaniu `position: relative` (bez z-index) oba są
       pozycjonowane z `z-index: auto` i decyduje kolejność drzewa:
       `.kt-write` stoi wcześniej, więc jego rycina ląduje POD
       formularzem. Gołąb schowka nie potrzebuje — pod `.kt-social`
       jest 195 px wolnego papieru do stopki, a wystaje 80 px. */
    .kt-formsec {
      position: relative;
    }
  }

  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna i kompletna). Mobile: reveale +
     rysowanie rycin maską + parallax rycin; desktop: rysowanie
     [data-rycsb] + dryf tła. Wzorce i wartości 1:1 z 4.2–4.6.
     Widok używa wyłącznie wariantu „r" (wszystkie ryciny wjeżdżają
     z prawej krawędzi — eksport). ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .kt [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .kt [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .kt [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .kt [data-rev][data-rev-d="2"] {
      transition-delay: 0.18s;
    }
    html.js-motion .kt [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .kt [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .kt [data-ryc="r"].in {
      animation: ktRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }
  @media (min-width: 1024px) {
    html.js-motion .kt [data-rycsb] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .kt [data-rycsb="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .kt [data-rycsb="r"].in {
      animation: ktRycR 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty masek „rysowania" (eksport: klin 255° + smugi) */
  .kt {
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-r: linear-gradient(
      255deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
  }
  @keyframes ktRycR {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
      filter: opacity(1);
    }
  }
</style>

<script>
  // Formularz — logika ładowana ZAWSZE (funkcja, nie dekoracja);
  // Turnstile dociąga się dopiero przy pierwszym focusie w formularzu,
  // więc nie wchodzi do bundle'a wejściowego.
  import { initContactUi } from "@/components/sections/contact/contact-ui";
  const section = document.querySelector<HTMLElement>("main.kt");
  if (section) initContactUi(section);

  // Ruch — dynamicznie, tylko przy motion OK (sections.md). Widok nie ma
  // zwijanych akapitów (analiza §1c), więc collapsible.ts nie wchodzi;
  // tradycja-motion.ts jest widoko-specyficzny i też nie.
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("@/components/sections/content-motion");
  }
</script>
