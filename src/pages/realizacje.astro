---
// Podstrona /realizacje/ (Etap 4.3) — port docs/design/export/
// realizacje.html; decyzje: docs/analiza-realizacje.md. Płaska lista
// BEZ kategorii i filtrów (E5): siatka kafli (1→2 kolumny przy 700 px)
// + paginacja (desktop) / „pokaż więcej" (mobile) jako czysty
// progressive enhancement — SSR renderuje WSZYSTKIE kafle i WSZYSTKIE
// <template data-work-detail>, JS tylko ukrywa; kontrolki są w SSR
// z atrybutem `hidden` i odsłania je dopiero skrypt. Detal = JEDEN
// overlay #work-detail (mechanizm delung: open-detail.ts / overlay.ts
// — bez zmian architektury, skin 4.3). Projnav i licznik detalu dostają
// kontekst PEŁNEJ listy (analiza §2 pkt 3). Media kafli w R2 — rozmiary
// wyłącznie przez imgAt() (w komponentach kafla/detalu).
import { getCollection } from "astro:content";
import house8 from "@/assets/dom-ryc-house8.webp";
import placBudowy from "@/assets/plac-budowy-photo3.webp";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import PaperBackdrop from "@/components/PaperBackdrop.astro";
import WorkDetail from "@/components/sections/work/WorkDetail.astro";
import WorkDetailOverlay from "@/components/sections/work/WorkDetailOverlay.astro";
import WorkIndexCard from "@/components/sections/work/WorkIndexCard.astro";
import {
  WORK_MOBILE_STEP,
  WORK_PAGE_SIZE,
} from "@/components/sections/work/work-config";
import {
  viewProject,
  type WorkProject,
} from "@/components/sections/work/work-data";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONTACT_PATH } from "@/lib/routes";

// Pełna lista (strona główna kapuje do 3) — kolejność wg `order` z CMS.
// Pusta kolekcja = stan dopuszczalny: pusta siatka, zero kontrolek.
const projects = (await getCollection("realizacje"))
  .map((e) => e.data as WorkProject)
  .sort((a, b) => a.order - b.order)
  .map(viewProject);
const pages = Math.ceil(projects.length / WORK_PAGE_SIZE);
---

<BaseLayout
  title={ui.pl["workPage.title"]}
  description={ui.pl["workPage.description"]}
>
  <script is:inline slot="head">
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów/rysowania — reszta w work-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar />

  <main class="wk">
    <PaperBackdrop />
    <header class="wk-head">
      <img
        class="wk-ryc"
        data-ryc="r"
        data-plxr
        src={house8.src}
        width={house8.width}
        height={house8.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="wk-head-t">
        <p class="wk-kick" data-rev>REALIZACJE</p>
        <h1 data-rev>Nasze realizacje</h1>
      </div>
      <p class="wk-lead" data-rev>
        Nie jesteśmy odtwórcami – jesteśmy technologami tradycji. Przejrzyj
        nasze portfolio i zobacz na własne oczy, jak w praktyce wygląda
        inżynieria, która współpracuje z prawami natury i upływającym czasem.
      </p>
    </header>

    <div class="wk-grid" data-tiles>
      {projects.map((project) => <WorkIndexCard project={project} />)}
    </div>

    {
      /* Kontrolki dawkowania siatki (E5) — SSR z `hidden`, odsłania JS
        (bez JS lista jest pełna, kontrolka byłaby martwa). Warianty per
        próg wybiera CSS (dOnly/mOnly), stan maluje skrypt niżej. */
    }
    {
      pages > 1 && (
        <nav
          class="wk-pag dOnly"
          data-pag
          aria-label="Stronicowanie realizacji"
          hidden
        >
          <button
            type="button"
            class="wk-pag-arr"
            data-pag-prev
            aria-label="Poprzednia strona"
            disabled
          >
            ←
          </button>
          {Array.from({ length: pages }, (_, i) => (
            <button
              type="button"
              data-pag-page={i}
              class={i === 0 ? "on" : undefined}
              aria-current={i === 0 ? "page" : undefined}
            >
              {i + 1}
            </button>
          ))}
          <button
            type="button"
            class="wk-pag-arr"
            data-pag-next
            aria-label="Następna strona"
          >
            →
          </button>
        </nav>
      )
    }
    {
      projects.length > WORK_MOBILE_STEP && (
        <div class="wk-morewrap mOnly" hidden data-more-wrap>
          <button type="button" class="wk-more" data-more>
            Pokaż więcej realizacji
            <svg viewBox="0 0 14 14" aria-hidden="true">
              <path
                d="M7 1.5v10M2.6 7.4L7 11.8l4.4-4.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>
      )
    }

    <section class="wk-cta">
      <img
        src={placBudowy.src}
        width={placBudowy.width}
        height={placBudowy.height}
        alt=""
        loading="lazy"
        decoding="async"
        data-tilepar
      />
      <span class="wk-cta-grad" aria-hidden="true"></span>
      <div class="wk-cta-in">
        <h2 data-rev>Twój dom może być naszą kolejną realizacją</h2>
        <a href={CONTACT_PATH} data-rev data-rev-d="1"
          >Skontaktuj się z nami →</a
        >
      </div>
    </section>
  </main>

  <Footer />

  {/* Treść detalu per realizacja — klonowana do #work-detail po kliknięciu. */}
  {
    projects.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail project={project} />
      </template>
    ))
  }
  <WorkDetailOverlay />
</BaseLayout>

<style is:global>
  /* ── Tokeny widoku (odczyty z eksportu — analiza §1). Mobile w bazie,
     desktop w @media 1024 (para: WORK_DESKTOP_MIN_PX); drugi próg 700
     WYŁĄCZNIE w siatce (para: WORK_GRID_TWO_COL_MIN_PX). ── */
  .wk {
    /* treść startuje pod paskiem fixed (4.1) */
    padding-top: var(--hdr-h);
    /* rycina nagłówka wystaje za krawędź — clip bez tworzenia scrollera */
    overflow-x: clip;
    /* kontener mobile (eksport: nagłówek 700/30, siatka 700/26) */
    --wmax: 700px;
    /* tło jak na stronie głównej (ten sam wzorzec eksportu): baza
       kremowa + duży skan papieru (PaperBackdrop, z-index -1 — stąd
       isolation); kafelek body zostaje pod chrome'em innych tras */
    position: relative;
    isolation: isolate;
    background: var(--bg-cream);
  }

  /* warianty per breakpoint (wzorzec dOnly/mOnly z 4.1/4.2) */
  @media (max-width: 1023.98px) {
    .wk .dOnly {
      display: none !important;
    }
  }
  @media (min-width: 1024px) {
    .wk .mOnly {
      display: none !important;
    }
  }

  /* ── nagłówek strony ── */
  .wk-head {
    position: relative;
    max-width: var(--wmax);
    margin-inline: auto;
    padding: 18px 30px 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
    overflow: hidden;
  }
  .wk-ryc {
    position: absolute;
    right: -54px;
    top: 82px;
    width: 190px;
    max-width: none;
    height: auto;
    opacity: 0.16;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .wk-head-t {
    display: contents;
  }
  .wk-kick {
    position: relative;
    margin: 0;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(87, 101, 74, 0.95);
  }
  .wk-head h1 {
    position: relative;
    margin: 0;
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: clamp(36px, 10.2vw, 40px);
    line-height: 1.08;
    color: var(--ink);
    max-width: 250px;
    text-wrap: pretty;
  }
  .wk-lead {
    position: relative;
    margin: 6px 0 0;
    font-family: var(--font-body), sans-serif;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--faint);
    text-wrap: pretty;
  }

  /* ── siatka kafli: 1 kolumna → 2 od 700 px (drugi próg projektu) ── */
  .wk-grid {
    position: relative;
    margin: 26px auto 0;
    max-width: var(--wmax);
    padding: 0 26px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 700px) {
    .wk-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── „pokaż więcej" (mobile) ── */
  .wk-morewrap {
    margin: 28px auto 0;
    max-width: var(--wmax);
    padding: 0 26px;
    box-sizing: border-box;
  }
  .wk-more {
    appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: none;
    border: 1px solid rgba(87, 101, 74, 0.55);
    color: var(--accent);
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: 13.5px;
    padding: 16px 20px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .wk-more:hover {
    background: rgba(87, 101, 74, 0.09);
  }
  .wk-more svg {
    flex: none;
    width: 13px;
    height: 13px;
  }

  /* ── paginacja (desktop) ── */
  .wk-pag {
    margin-top: clamp(30px, 5.8vh, 56px);
    padding: 0 var(--g);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .wk-pag button {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(40px, 3.06vw, 49px);
    height: clamp(40px, 3.06vw, 49px);
    box-sizing: border-box;
    background: none;
    border: 1px solid rgba(33, 29, 24, 0.28);
    color: var(--ink);
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: clamp(10px, 0.76vw, 12px);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .wk-pag button:hover {
    background: rgba(87, 101, 74, 0.1);
  }
  .wk-pag button.on {
    background: #26221b;
    border-color: #26221b;
    color: #f5efe3;
    cursor: default;
  }
  .wk-pag .wk-pag-arr {
    color: var(--accent);
  }
  .wk-pag .wk-pag-arr[data-pag-next] {
    margin-left: 6px;
  }
  .wk-pag .wk-pag-arr[data-pag-prev] {
    margin-right: 6px;
  }
  /* krańce: strzałka znika, siatka przycisków stron nie skacze */
  .wk-pag .wk-pag-arr[disabled] {
    visibility: hidden;
  }

  /* ── CTA nad stopką ── */
  .wk-cta {
    position: relative;
    margin-top: 38px;
    overflow: hidden;
    min-height: 290px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--bg-dark);
  }
  /* zapas 70 px = ruch parallaxu [data-tilepar] (D-U1) */
  .wk-cta > img {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: calc(100% + 70px);
    max-width: none;
    object-fit: cover;
    transform: translate3d(0, -35px, 0);
    filter: grayscale(1) contrast(1.05);
    opacity: 0.55;
  }
  .wk-cta-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 19, 14, 0.25) 0%,
      rgba(24, 19, 14, 0.82) 100%
    );
  }
  .wk-cta-in {
    position: relative;
    max-width: var(--wmax);
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
    padding: 0 30px 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    color: #f5efe3;
  }
  .wk-cta h2 {
    margin: 0;
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: clamp(28px, 7.7vw, 30px);
    line-height: 1.16;
    max-width: 268px;
    text-wrap: pretty;
  }
  .wk-cta a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ece8dd;
    color: #26221b;
    text-decoration: none;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 15px 26px;
    border-radius: 2px;
    transition: background 0.2s ease;
  }
  .wk-cta a:hover {
    background: #f5efe3;
  }

  /* ════ Desktop ≥1024 (para: WORK_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .wk {
      --wmax: 1600px;
    }
    .wk-head {
      max-width: var(--wmax);
      padding: clamp(34px, 6.9vh, 62px) var(--g) 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(44px, 5.55vw, 89px);
      align-items: end;
      overflow: visible;
    }
    .wk-head-t {
      display: flex;
      flex-direction: column;
      gap: clamp(11px, 1.11vw, 18px);
    }
    .wk-ryc {
      right: calc(var(--g) * 0.6);
      top: -18px;
      width: clamp(170px, 17.4vw, 278px);
      opacity: 0.15;
    }
    .wk-kick {
      font-size: clamp(10px, 0.76vw, 12px);
    }
    .wk-head h1 {
      font-size: clamp(40px, 4.38vw, 70px);
      line-height: 1.02;
      max-width: none;
    }
    .wk-lead {
      margin: 0 0 6px;
      justify-self: start;
      max-width: clamp(400px, 36.1vw, 578px);
      font-size: clamp(16px, 1.32vw, 21px);
      line-height: 1.65;
    }
    .wk-grid {
      margin-top: clamp(32px, 6.2vh, 58px);
      max-width: var(--wmax);
      padding: 0 var(--g);
      grid-template-columns: 1fr 1fr;
      gap: clamp(20px, 3.3vh, 32px) clamp(20px, 1.95vw, 31px);
    }
    .wk-cta {
      margin-top: clamp(48px, 10.2vh, 96px);
      min-height: 0;
      height: clamp(300px, 44vh, 440px);
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
    .wk-cta > img {
      height: 100%;
      transform: none;
    }
    .wk-cta-grad {
      background: linear-gradient(
        90deg,
        rgba(24, 19, 14, 0.88),
        rgba(24, 19, 14, 0.42)
      );
    }
    .wk-cta-in {
      max-width: var(--wmax);
      padding: 0 var(--g);
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: clamp(40px, 4.17vw, 67px);
    }
    .wk-cta h2 {
      font-size: clamp(30px, 3.06vw, 49px);
      line-height: 1.1;
      max-width: clamp(440px, 38.9vw, 622px);
    }
    .wk-cta a {
      flex: none;
      font-size: clamp(13.5px, 1.08vw, 17px);
      padding: clamp(14px, 1.18vw, 19px) clamp(24px, 2.08vw, 33px);
    }
  }

  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna). Mobile: reveale + rysowanie ryciny
     maską; desktop statyczny (jak eksport). Maska schodzi z elementu po
     animacji (work-motion.ts — lekcja D-Q1). Wzorzec i wartości 1:1
     z 4.2 (index.astro). ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .wk [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .wk [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .wk [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .wk [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .wk [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .wk [data-ryc="r"].in {
      animation: wkRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty maski „rysowania" (eksport: klin 255° + smugi — jak 4.2) */
  .wk {
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-r: linear-gradient(
      255deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
  }
  @keyframes wkRycR {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
      filter: opacity(1);
    }
  }
</style>

<script>
  // Otwieranie detalu + dawkowanie siatki (E5). Mechanizm detalu bez
  // zmian: openWorkDetail klonuje <template> do #work-detail.
  import {
    openWorkDetail,
    setDetailContext,
  } from "@/components/sections/work/open-detail";
  import {
    WORK_DESKTOP_MIN_PX,
    WORK_MOBILE_STEP,
    WORK_PAGE_SIZE,
  } from "@/components/sections/work/work-config";

  const tiles = Array.from(
    document.querySelectorAll<HTMLElement>("[data-tiles] [data-work-slug]"),
  );

  // Projnav i licznik REALIZACJA NN / NN chodzą po PEŁNEJ liście —
  // paginacja tylko dawkuje siatkę, lista jest płaska (analiza §2 pkt 3).
  setDetailContext(
    tiles.map((tile) => ({
      slug: tile.dataset.workSlug ?? "",
      name: tile.dataset.workName ?? "",
    })),
  );

  // Klik/tap w kafel → detal.
  document
    .querySelector<HTMLElement>("[data-tiles]")
    ?.addEventListener("click", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-work-slug]",
      );
      if (!card?.dataset.workSlug) return;
      openWorkDetail(card.dataset.workSlug, card.dataset.workName ?? "");
    });

  // ── dawkowanie siatki: paginacja (desktop) / „pokaż więcej" (mobile) ──
  const pag = document.querySelector<HTMLElement>("[data-pag]");
  const moreWrap = document.querySelector<HTMLElement>("[data-more-wrap]");
  const moreBtn = document.querySelector<HTMLElement>("[data-more]");
  const desktopMQ = matchMedia(`(min-width:${WORK_DESKTOP_MIN_PX}px)`);
  const motionOK = matchMedia("(prefers-reduced-motion: no-preference)");
  const pageCount = Math.ceil(tiles.length / WORK_PAGE_SIZE);
  let page = 0;
  let shown = WORK_MOBILE_STEP;

  // kontrolki są w SSR z `hidden` (bez JS lista jest pełna) — JS je
  // uzbraja; widoczność per próg robi CSS (dOnly/mOnly)
  if (pag) pag.hidden = false;
  if (moreWrap) moreWrap.hidden = false;

  function paintDesktop() {
    tiles.forEach((tile, i) => {
      tile.hidden = Math.floor(i / WORK_PAGE_SIZE) !== page;
    });
    pag
      ?.querySelectorAll<HTMLButtonElement>("[data-pag-page]")
      .forEach((b, i) => {
        b.classList.toggle("on", i === page);
        if (i === page) b.setAttribute("aria-current", "page");
        else b.removeAttribute("aria-current");
      });
    const prev = pag?.querySelector<HTMLButtonElement>("[data-pag-prev]");
    const next = pag?.querySelector<HTMLButtonElement>("[data-pag-next]");
    if (prev) prev.disabled = page === 0;
    if (next) next.disabled = page === pageCount - 1;
  }

  function paintMobile() {
    tiles.forEach((tile, i) => {
      tile.hidden = i >= shown;
    });
    if (moreWrap) moreWrap.hidden = shown >= tiles.length;
  }

  function apply() {
    if (desktopMQ.matches) paintDesktop();
    else paintMobile();
  }

  /** Zmiana strony przewija do początku siatki (pierwszy widoczny kafel
   *  pod paskiem chrome'u) — inaczej użytkownik zostaje na dole listy
   *  i nie widzi wyniku (wzorzec delung D-T2). */
  function scrollToGridTop() {
    const first = tiles.find((tile) => !tile.hidden);
    if (!first) return;
    const hdr =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--hdr-h"),
      ) || 0;
    const cel = Math.max(
      0,
      Math.round(first.getBoundingClientRect().top + window.scrollY - hdr - 12),
    );
    window.scrollTo({
      top: cel,
      behavior: motionOK.matches ? "smooth" : "auto",
    });
  }

  pag?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("button");
    if (!b || (b as HTMLButtonElement).disabled) return;
    if (b.hasAttribute("data-pag-prev")) page = Math.max(0, page - 1);
    else if (b.hasAttribute("data-pag-next"))
      page = Math.min(pageCount - 1, page + 1);
    else if (b.dataset.pagPage !== undefined) {
      const n = Number(b.dataset.pagPage);
      if (n === page) return;
      page = n;
    } else return;
    paintDesktop();
    scrollToGridTop();
  });

  // „pokaż więcej" dokłada pod spodem — bez skoku scrolla
  moreBtn?.addEventListener("click", () => {
    shown += WORK_MOBILE_STEP;
    paintMobile();
  });

  // Przejście przez próg resetuje dawkowanie (stan per tryb nie ma
  // sensu między układami); otwarty detal zamyka open-detail.ts.
  desktopMQ.addEventListener("change", () => {
    page = 0;
    shown = WORK_MOBILE_STEP;
    apply();
  });
  apply();

  // Ruch — dynamicznie, tylko przy motion OK (sections.md).
  if (motionOK.matches) {
    import("@/components/sections/work/work-motion");
  }
</script>
