    html.js-motion .eka [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .eka [data-ryc="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
    }
    html.js-motion .eka [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .eka [data-ryc="l"].in {
      animation: ekaRycL 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    html.js-motion .eka [data-ryc="r"].in {
      animation: ekaRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    /* kaskada rzędu domków (eksport: delaye 0/.35/.7 s) */
    html.js-motion .eka .trud-domki img:nth-child(2)[data-ryc].in {
      animation-delay: 0.35s;
    }
    html.js-motion .eka .trud-domki img:nth-child(3)[data-ryc].in {
      animation-delay: 0.7s;
    }
  }
  @media (min-width: 1024px) {
    html.js-motion .eka [data-rycsb] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
