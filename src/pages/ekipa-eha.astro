     D-Q1). Wzorce i wartości 1:1 z 4.2/4.3. ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .eka [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .eka [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .eka [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
