---
// Podstrona /ekipa-eha/ (Etap 4.4, część 1) — port docs/design/export/
// ekipa-eha.html; decyzje: docs/analiza-ekipa.md. Hero z ciemnym
// zdjęciem pod przezroczystym paskiem (Navbar tone="dark" — krem do
// stanu solid), biogramy Łukasz/Maciek, płyty tytułowe sekcji, ZWIJANE
// AKAPITY (mobile) wspólnym modułem CollapsibleText + collapsible.ts
// (progressive enhancement jak paginacja E5 — SSR z pełnym tekstem),
// CTA i stopka 4.1. Ruch za bramką js-motion wspólnym modułem
// content-motion.ts (reveale/rysowanie/parallaxy/dryf tła — wzorce
// 4.2/4.3); bez JS / przy reduce strona statyczna i kompletna.
import budowlana1 from "@/assets/ekipa-budowlana1.webp";
import budowlana2 from "@/assets/ekipa-budowlana2.webp";
import house1 from "@/assets/dom-ryc-house1.webp";
import house2 from "@/assets/dom-ryc-house2.webp";
import house3 from "@/assets/dom-ryc-house3.webp";
import house4 from "@/assets/dom-ryc-house4.webp";
import house6 from "@/assets/dom-ryc-house6.webp";
import house8 from "@/assets/dom-ryc-house8.webp";
import houseOld from "@/assets/house-old1.webp";
import kolekD from "@/assets/eha-kolek-ryc.webp";
import kolekM from "@/assets/eha-kolek-ryc-m.webp";
import lukasz from "@/assets/lukasz-portrait.webp";
import maciek from "@/assets/maciek2.webp";
import onas2 from "@/assets/eha-o-nas2.webp";
import planRyc from "@/assets/plan-ryc1.webp";
import sufitem from "@/assets/maciek-pod-sufitem.webp";
import technicalRyc from "@/assets/technical-ryc.webp";
import techElems from "@/assets/technical-elements-ryc.webp";
import warsztat from "@/assets/warsztat-ryc1.webp";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import PaperBackdrop from "@/components/PaperBackdrop.astro";
import CollapsibleText from "@/components/sections/CollapsibleText.astro";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONTACT_PATH } from "@/lib/routes";
---

<BaseLayout
  title={ui.pl["ekipaPage.title"]}
  description={ui.pl["ekipaPage.description"]}
>
  <script is:inline slot="head">
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów/rysowania — reszta w content-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar tone="dark" />

  <main class="eka">
    <PaperBackdrop />

    {/* ── hero: ciemne zdjęcie wygasające w papier, h1 na dole ── */}
    <header class="eka-hero" data-navref>
      <div class="eka-hero-ph">
        <img
          data-plx
          src={onas2.src}
          width={onas2.width}
          height={onas2.height}
          alt="Ekipa EH/A na budowie"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {/* gradient czytelności kremowego paska (tone="dark") */}
        <span class="eka-hero-top" aria-hidden="true"></span>
      </div>
      <h1>Ekipa EH/A.</h1>
    </header>

    {/* ── intro: motto + akapit wprowadzenia ── */}
    <section class="eka-intro">
      <img
        class="eka-int-rycm mOnly"
        data-ryc="r"
        data-plxr
        src={house3.src}
        width={house3.width}
        height={house3.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="eka-int-ryc1 dOnly"
        data-rycsb="l"
        src={house3.src}
        width={house3.width}
        height={house3.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="eka-int-ryc2 dOnly"
        data-rycsb="r"
        src={warsztat.src}
        width={warsztat.width}
        height={warsztat.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="eka-int-in">
        <p class="eka-motto">Dwa umysły, jedna rzemieślnicza pasja.</p>
        <p class="eka-int-p">
          Nie jesteśmy typową firmą budowlaną. Pracownia EH/A zrodziła się z
          ucieczki przed miejskim zgiełkiem, z głębokiego szacunku do
          historycznej tkanki architektonicznej i z fascynacji technologiami,
          które przetrwały próbę czasu. Za naszymi realizacjami stoją dwa
          zupełnie różne umysły – analityczny i badawczy – które połączyły siły,
          by przywracać do życia to, co inni uznali za niemożliwe do uratowania.
        </p>
      </div>
    </section>

    {/* ── pas zdjęcia przejściowego ── */}
    <div class="eka-band">
      <img
        data-plx
        src={sufitem.src}
        width={sufitem.width}
        height={sufitem.height}
        alt="Maciek przy pracy pod sufitem"
        loading="lazy"
        decoding="async"
      />
    </div>

    {/* ── biogramy ── */}
    <section class="eka-bios">
      <img
        class="eka-bios-ryc dOnly"
        data-rycsb="l"
        src={planRyc.src}
        width={planRyc.width}
        height={planRyc.height}
        alt=""
        loading="lazy"
        decoding="async"
      />

      <article class="bio bio-l">
        <img
          class="bio-ryc mOnly"
          data-ryc="r"
          data-plxr
          src={house1.src}
          width={house1.width}
          height={house1.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <h2>Od sieci korporacyjnych do sieci słupowo-ryglowych</h2>
        <figure class="bio-port">
          <span class="bio-port-ph">
            <img
              src={lukasz.src}
              width={lukasz.width}
              height={lukasz.height}
              alt="Łukasz"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true"></span>
          </span>
          <figcaption>ŁUKASZ</figcaption>
        </figure>
        <CollapsibleText id="bio-lukasz" collapsedMax="98px" class="bio-txt">
          <p>
            Łukasz przez lata funkcjonował w świecie zaawansowanych technologii.
            Jako specjalista i menedżer w dużych korporacjach zarządzał
            zespołami i projektował skomplikowane sieci komputerowe. Ten ścisły,
            analityczny umysł, przyzwyczajony do rozwiązywania problemów i
            optymalizacji procesów, znalazł jednak swoje prawdziwe powołanie z
            dala od przeszklonych biurowców. Decyzja o przeprowadzce na Dolny
            Śląsk i zakup starego domu do remontu okazała się punktem zwrotnym.
            Prace, które miały być tylko prywatnym projektem, przerodziły się w
            absolutną fascynację rzemiosłem. Zrozumiał, że kierowanie budową i
            zgłębianie technologii wznoszenia historycznych budynków wymaga
            równie dużej precyzji, co architektura IT. Przebranżowił się, zaczął
            zarządzać ekipami na specjalistycznych budowach i na jednej z nich
            poznał Maćka.
          </p>
        </CollapsibleText>
      </article>

      <article class="bio bio-m">
        <img
          class="bio-ryc mOnly"
          data-ryc="l"
          data-plxr
          src={house8.src}
          width={house8.width}
          height={house8.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <h2>Geologiczna precyzja i zrozumienie materii</h2>
        <figure class="bio-port">
          <span class="bio-port-ph">
            <img
              src={maciek.src}
              width={maciek.width}
              height={maciek.height}
              alt="Maciek"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true"></span>
          </span>
          <figcaption>MACIEK</figcaption>
        </figure>
        <CollapsibleText id="bio-maciek" collapsedMax="98px" class="bio-txt">
          <p>
            Maciek to człowiek, który materię budowlaną rozumie od samych jej
            fundamentów – dosłownie. Jako magister geologii (związany z tą
            dziedziną nauki od 2015 roku), posiada unikalną wiedzę o kamieniu,
            surowcach i procesach zachodzących w naturze. Jego wędrówki po
            Dolnym Śląsku szybko przerodziły się w fascynację lokalną,
            historyczną architekturą. Wiedza o strukturze ziemi i skał płynnie
            przeniosła się na zrozumienie starych zapraw, zachowania murów i
            oddziaływania wilgoci na budynek. Pracując przy renowacjach, spotkał
            Łukasza. Szybko okazało się, że choć wywodzą się z zupełnie innych
            światów, dzielą tę samą bezkompromisowość i pasję do starego
            budownictwa. Połączenie sił i stworzenie Pracowni EH/A było
            naturalnym krokiem.
          </p>
        </CollapsibleText>
      </article>
    </section>

    <div class="eka-sep mOnly" aria-hidden="true"></div>

    {/* ── płyta + treść: NASZE KORZENIE ── */}
    <section class="eka-plate eka-plate-dzie">
      <div class="eka-plate-bg" aria-hidden="true">
        <img
          data-plx
          src={houseOld.src}
          width={houseOld.width}
          height={houseOld.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="eka-plate-fog"></span>
      </div>
      <div class="eka-plate-in">
        <p class="eka-kick" data-rev>NASZE KORZENIE</p>
        <h2 data-rev data-rev-d="1">
          Dolnośląskie dziedzictwo, zachodnia szkoła rzemiosła
        </h2>
      </div>
    </section>

    <section class="eka-s1">
      <CollapsibleText id="sec-korzenie" collapsedMax="112px" class="s-clp">
        <p class="s1-lead">
          Pracujemy na Dolnym Śląsku, ale technologicznie i ideowo patrzymy za
          naszą zachodnią granicę. To właśnie tam, w Niemczech, znajduje się
          prawdziwa kolebka technologii, z których czerpiemy najwięcej.
          Architektura domów przysłupowych (<em>Umgebindehäuser</em>), klasyczny <em
            >Fachwerk</em
          > (mury pruskie i szachulcowe) czy potężne stodoły oparte na dębowych ramach,
          to dla nas niedoścignione wzorce sztuki budowlanej.
        </p>
        <div class="s1-cards">
          <div class="eka-card">
            <p class="eka-card-k">UMGEBINDEHAUS · DOM PRZYSŁUPOWY</p>
            <p class="eka-card-t">
              Izba zrębowa objęta niezależną ramą słupową, która niesie piętro i
              dach — ściany izby nie dźwigają konstrukcji.
            </p>
          </div>
          <div class="eka-card">
            <p class="eka-card-k">FACHWERK · MUR PRUSKI I SZACHULEC</p>
            <p class="eka-card-t">
              Szkielet z dębowych słupów i rygli, wypełniany cegłą lub gliną ze
              słomą — konstrukcja widoczna na elewacji.
            </p>
          </div>
        </div>
        <div class="s1-close">
          <img
            class="s1-kolek-m mOnly"
            data-ryc="l"
            src={kolekM.src}
            width={kolekM.width}
            height={kolekM.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="s1-kolek-d dOnly"
            data-rycsb="r"
            src={kolekD.src}
            width={kolekD.width}
            height={kolekD.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <p>
            Naszym celem jest wskrzeszanie tych zachodnich tradycji i
            przeszczepianie ich precyzji na grunt dolnośląskich renowacji.
            Świadomie wzorujemy się na starych mistrzach ciesielstwa i
            murarstwa. Rozumiemy, jak pracują połączenia na drewniane kołki, jak
            zachowuje się konstrukcja przysłupowa i dlaczego historyczny ustrój
            nośny wymaga najwyższej kultury technicznej, a nie współczesnych
            dróg na skróty. Odnawiając domy w regionie, nie tylko prowadzimy
            prace budowlane – my ratujemy kulturowy i architektoniczny krajobraz
            tych ziem, mocno wiążąc go z jego historycznymi korzeniami.
          </p>
        </div>
      </CollapsibleText>
    </section>

    {/* ── płyta + treść: INŻYNIERIA TRADYCJI ── */}
    <section class="eka-trud">
      <div class="trud-row">
        <div class="eka-plate trud-panel">
          <div class="eka-plate-bg" aria-hidden="true">
            <img
              data-plx
              src={technicalRyc.src}
              width={technicalRyc.width}
              height={technicalRyc.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="eka-plate-fog"></span>
          </div>
          <div class="eka-plate-in">
            <p class="eka-kick" data-rev>INŻYNIERIA TRADYCJI</p>
            <h2 data-rev data-rev-d="1">Im trudniej, tym lepiej</h2>
          </div>
        </div>
        {/* desktop: akapit obok panelu (mobile ma go w zwijanej treści) */}
        <p class="trud-p1 dOnly">
          Tam, gdzie inni wykonawcy rozkładają ręce, my widzimy przestrzeń do
          działania. Z największą pasją podejmujemy się wyzwań, które wymagają
          inżynieryjnego myślenia i doskonałej znajomości starych technologii.
          Naszą wizytówką są skomplikowane prace murarskie i odtwarzanie
          historycznych sklepień. Niezależnie od tego, czy jest to sklepienie
          kolebkowe, żagliste, krzyżowo-żebrowe czy skomplikowane łuki okienne –
          traktujemy to jak architektoniczną łamigłówkę. Pracujemy w starej
          cegle rozbiórkowej, kamieniu i tradycyjnych zaprawach, przywracając
          budynkom ich dawną statykę i duszę.
        </p>
      </div>
      <CollapsibleText
        id="sec-trudniej"
        collapsedMax="112px"
        class="s-clp trud-clp"
      >
        <div class="trud-b1 mOnly">
          <img
            class="trud-ryc1"
            data-ryc="r"
            src={house6.src}
            width={house6.width}
            height={house6.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <p>
            Tam, gdzie inni wykonawcy rozkładają ręce, my widzimy przestrzeń do
            działania. Z największą pasją podejmujemy się wyzwań, które wymagają
            inżynieryjnego myślenia i doskonałej znajomości starych technologii.
            Naszą wizytówką są skomplikowane prace murarskie i odtwarzanie
            historycznych sklepień. Niezależnie od tego, czy jest to sklepienie
            kolebkowe, żagliste, krzyżowo-żebrowe czy skomplikowane łuki okienne
            – traktujemy to jak architektoniczną łamigłówkę. Pracujemy w starej
            cegle rozbiórkowej, kamieniu i tradycyjnych zaprawach, przywracając
            budynkom ich dawną statykę i duszę.
          </p>
        </div>
        <div class="trud-b2">
          <img
            class="trud-ryc2 mOnly"
            data-ryc="l"
            data-plxr
            src={house8.src}
            width={house8.width}
            height={house8.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <p>
            Z równym zaangażowaniem podchodzimy do ciesielstwa. Ustrój
            słupowo-ryglowy, potężne więźby dachowe i misterne detale
            konstrukcyjne to nasza codzienność. Nie boimy się łączyć wiekowego,
            historycznego drewna z nowym, starannie wyselekcjonowanym i
            wysuszonym materiałem. Znamy i stosujemy tradycyjne złącza
            ciesielskie, ponieważ wiemy, że to one gwarantują trwałość liczoną w
            setkach lat.
          </p>
        </div>
        <div class="trud-tail">
          <div class="trud-domki" aria-hidden="true">
            <img
              data-ryc="l"
              src={house8.src}
              width={house8.width}
              height={house8.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <img
              data-ryc="l"
              src={house6.src}
              width={house6.width}
              height={house6.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <img
              data-ryc="l"
              src={house4.src}
              width={house4.width}
              height={house4.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="trud-quote">
            „Nie jesteśmy odtwórcami – jesteśmy świadomymi technologami, dla
            których tradycja to nauka, a nie tylko estetyka.”
          </p>
        </div>
      </CollapsibleText>
    </section>

    {/* ── płyta + treść: SIEĆ MISTRZÓW ── */}
    <section class="eka-plate eka-plate-siec">
      <div class="eka-plate-bg" aria-hidden="true">
        <img
          data-plx
          src={budowlana1.src}
          width={budowlana1.width}
          height={budowlana1.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="eka-plate-fog"></span>
      </div>
      <div class="eka-plate-in">
        <div class="eka-plate-t">
          <p class="eka-kick" data-rev>SIEĆ MISTRZÓW</p>
          <h2 data-rev data-rev-d="1">
            Sprawdzona sieć mistrzów i absolutny spokój inwestora
          </h2>
        </div>
        <img
          class="siec-ryc dOnly"
          src={techElems.src}
          width={techElems.width}
          height={techElems.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="eka-s3">
      <CollapsibleText id="sec-siec" collapsedMax="112px" class="s-clp">
        <div class="s3-grid">
          <p class="s3-p1">
            EH/A to my: Łukasz i Maciek. Jesteśmy trzonem i mózgiem każdej
            operacji. Wiemy jednak, że kompleksowa renowacja starego domu to
            skomplikowany organizm. Dlatego nie zatrudniamy przypadkowych
            podwykonawców z ogłoszenia. Przez lata obecności na rynku
            zbudowaliśmy wokół siebie starannie wyselekcjonowaną sieć zaufanych,
            lokalnych rzemieślników i specjalistów. To ludzie, z którymi
            pracowaliśmy jeszcze na długo przed założeniem naszej firmy, i za
            których jakość ręczymy osobiście.
          </p>
          <div class="s3-motto">
            <img
              class="s3-ryc-m mOnly"
              data-ryc="l"
              src={techElems.src}
              width={techElems.width}
              height={techElems.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <p class="s3-kick">NASZ MODEL DZIAŁANIA JEST PROSTY</p>
            <p class="s3-quote">
              Ty przyjeżdżasz na budowę tylko po to, by cieszyć się postępami i
              zatwierdzać detale estetyczne.
            </p>
          </div>
          <div class="s3-p2w">
            <img
              class="s3-ryc2 mOnly"
              data-ryc="l"
              data-plxr
              src={house2.src}
              width={house2.width}
              height={house2.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <p>
              Cały ciężar inwestycji – od logistyki, przez koordynację prac
              naszej zaufanej sieci rzemieślników, aż po rozwiązywanie
              skomplikowanych problemów konstrukcyjnych – bierzemy na siebie.
            </p>
          </div>
          <div class="s3-cards">
            <div class="eka-card">
              <p class="eka-card-k">ŁUKASZ · ŻELAZNE HARMONOGRAMY</p>
              <p class="eka-card-t">
                Menedżerskie doświadczenie spina logistykę i harmonogramy prac w
                żelazne ramy.
              </p>
            </div>
            <div class="eka-card">
              <p class="eka-card-k">MACIEK · TECHNOLOGIE I MATERIAŁY</p>
              <p class="eka-card-t">
                Czuwa nad właściwym doborem technologii i materiałów do wieku i
                konstrukcji domu.
              </p>
            </div>
          </div>
          <p class="s3-p3">
            Dzięki temu, mimo skali i trudności, z jaką wiąże się odbudowa
            wiekowego domu, nasz klient otrzymuje to, co w dzisiejszych czasach
            najcenniejsze – całkowity spokój umysłu i poczucie pełnego
            zaopiekowania.
          </p>
        </div>
      </CollapsibleText>
    </section>

    {/* ── CTA nad stopką ── */}
    <section class="eka-cta">
      <div class="eka-cta-ph" aria-hidden="true">
        <img
          data-plx
          src={budowlana2.src}
          width={budowlana2.width}
          height={budowlana2.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="eka-cta-grad" aria-hidden="true"></span>
      <div class="eka-cta-in">
        <p>Zaopiekujemy się także Twoim domem.</p>
        <a href={CONTACT_PATH}>Porozmawiajmy o Twoim domu →</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

