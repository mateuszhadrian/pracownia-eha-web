     typograficzne desktop identyczne z .eka (te same formuły
     w eksportach 4.4). ── */
  .kmp {
    /* kontener mobile eksportu: 700/30 */
    --wmax: 700px;
    /* ryciny/kadry wystają za krawędź — clip bez tworzenia scrollera */
    overflow-x: clip;
    /* tło jak `/`, /realizacje/ i /ekipa-eha/: baza kremowa + skan
       papieru (PaperBackdrop, z-index -1 — stąd isolation) */
    position: relative;
    isolation: isolate;
    background: var(--bg-cream);
  }
  @media (min-width: 1024px) {
    .kmp {
      --wmax: 1600px;
      --body: clamp(13.5px, 1.08vw, 17px);
      --lhb: 1.72;
      --mono: clamp(10px, 0.76vw, 12px);
      --monos: clamp(9px, 0.66vw, 10.5px);
      --h2: clamp(31px, 2.78vw, 44px);
