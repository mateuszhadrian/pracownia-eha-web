    box-sizing: border-box;
    width: 100%;
    padding: 6px 30px 0;
  }
  .inst-p1w {
    position: relative;
  }
  .inst-ryc {
    left: 0;
    right: 0;
    top: -8px;
    height: 112px;
  }
  .inst-ryc > img {
    right: -64px;
    top: -14px;
    width: 146px;
  }
  .inst-body p {
    position: relative;
    margin: 0;
    font-family: var(--font-body), sans-serif;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
  }
  .inst-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-top: 20px;
  }
  .inst-row > p {
    font-size: 13.5px;
    line-height: 1.65;
  }
  .inst-pol {
    margin: 0;
    flex: none;
    background: var(--bg-card);
    border: 1px solid rgba(33, 29, 24, 0.18);
    box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
    padding: 7px 7px 5px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .inst-pol-ph {
    position: relative;
    display: block;
    width: 126px;
    height: 162px;
  }
  .inst-pol-ph > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    border: 1px solid rgba(33, 29, 24, 0.25);
    filter: sepia(0.52) saturate(0.95) contrast(1.03);
  }
  .inst-pol figcaption {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: rgba(33, 29, 24, 0.65);
  }
  .inst-para {
    position: relative;
    margin: 24px auto 0;
    max-width: 1000px;
    box-sizing: border-box;
    width: 100%;
    padding: 0 30px;
    display: flex;
    align-items: stretch;
    gap: 14px;
    /* wysokość kadrów pary (eksport: clamp(90px, 44.4cqw − 18.7px, 300px);
       cqw kontenera ≈ vw — odchyłka pomijalna, analiza §2.6) */
    --iph: clamp(90px, 44.4vw - 18.7px, 300px);
  }
  .ip-card {
    margin: 0;
    background: var(--bg-card);
    border: 1px solid rgba(33, 29, 24, 0.18);
    box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
    padding: 7px 7px 5px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ip-a {
    flex: none;
    /* jawna szerokość karty (eksport: 0.75·H + 16px ramki) — bez niej
       karta rośnie do max-content jednolinijkowego podpisu */
    width: calc(var(--iph) * 0.75 + 16px);
    box-sizing: border-box;
  }
  .ip-a > img {
    display: block;
    height: var(--iph);
    width: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    filter: sepia(0.42) saturate(0.9) contrast(1.04);
  }
  .ip-b {
    flex: 1 1 0;
    min-width: 0;
  }
  .ip-b > img {
    display: block;
    height: var(--iph);
    width: 100%;
    object-fit: cover;
    object-position: 50% 55%;
    filter: sepia(0.52) saturate(0.95) contrast(1.03);
  }
  .ip-card figcaption {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: clamp(8px, 2.6vw, 9.5px);
    line-height: 1.35;
    letter-spacing: 0.1em;
    color: rgba(33, 29, 24, 0.65);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  /* ── świadome granice ── */
  .kmp-gran {
    position: relative;
  }
  .gran-head .kmp-sec-head-in {
    padding-top: 64px;
  }
  .gran-ryc > img {
    right: -74px;
    top: -14px;
    width: 146px;
  }
  .gf-in {
    position: relative;
    max-width: var(--wmax);
    margin-inline: auto;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .gran-sep {
    display: block;
    margin: 24px auto 0;
    width: calc(100% - 52px);
    max-width: 648px;
    border-top: 1px dashed rgba(33, 29, 24, 0.3);
  }
  .gran-quote {
    margin: 20px 34px 0;
    text-align: center;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.5;
    color: var(--sepia);
    text-wrap: pretty;
  }
  .gran-cta {
    margin: 22px 30px 0;
    padding: 15px 28px;
  }
  .gran-strip {
    position: relative;
    margin-top: 26px;
    height: 280px;
    overflow: hidden;
  }
  .gs-in {
    position: absolute;
    inset: 0;
    background: #362b20;
    -webkit-mask-image: linear-gradient(
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0.4) 18%,
      #000 46%
    );
    mask-image: linear-gradient(
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0.4) 18%,
      #000 46%
    );
  }
  /* zapas kadru = ruch parallaxu (D-U1) */
  .gs-in > img {
    position: absolute;
    left: 0;
    right: 0;
    top: -9%;
    width: 100%;
    height: 118%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 58%;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: luminosity;
    opacity: 0.9;
  }

  /* ── odstępy sekcji (mobile) ── */
  @media (max-width: 1023.98px) {
    .kmp-cies,
    .kmp-mur,
    .kmp-skl,
    .kmp-inst,
    .kmp-gran {
      margin-top: 34px;
    }
  }

  /* ════ DESKTOP ≥1024 (para: CONTENT_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    /* hero: obraz 62vh wystaje w dół pod płytę tytułową (rząd 2) */
    .kmp-head {
      grid-template-rows: calc(62vh - clamp(64px, 6.6vw, 106px)) auto;
    }
    .kmp-hero-ph {
      grid-row: 1;
      grid-column: 1;
      align-self: start;
      width: 100%;
      height: 62vh;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .kmp-hero-ph > img {
      top: 0;
      height: 100%;
      object-position: 50% 40%;
      filter: sepia(0.14) saturate(0.86);
    }
    .kmp-hero-top {
      height: clamp(130px, 13.2vw, 210px);
      background: linear-gradient(rgba(24, 19, 14, 0.62), rgba(24, 19, 14, 0));
    }
    .kmp-tt {
      grid-row: 2;
      grid-column: 1;
      align-self: start;
      justify-self: start;
      width: auto;
      max-width: clamp(600px, 62vw, 990px);
      margin: 0 var(--g);
      background: var(--bg-cream);
      border: 1px solid rgba(33, 29, 24, 0.18);
      box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
      padding: clamp(30px, 3vw, 48px) clamp(34px, 3.6vw, 58px);
      display: flex;
      flex-direction: column;
      gap: clamp(12px, 1.2vw, 19px);
    }
    .kmp-tt h1 {
      font-size: clamp(40px, 3.75vw, 60px);
      line-height: 1.04;
      text-wrap: pretty;
    }
    .kmp-tt .kmp-lead {
      font-size: clamp(21px, 1.83vw, 29px);
      line-height: 1.28;
    }
    .kmp-kick {
      font-size: var(--mono);
    }

    /* intro */
    .int-rycw {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .int-rycw > img {
      position: absolute;
      left: -3.6vw;
      top: clamp(10px, 1vw, 16px);
      width: clamp(250px, 24vw, 384px);
      max-width: none;
      height: auto;
      opacity: 0.2;
      mix-blend-mode: multiply;
    }
    .int-in {
      max-width: var(--wmax);
      padding: clamp(36px, 3.6vw, 58px) var(--g) clamp(60px, 5.8vw, 94px);
      display: flex;
      flex-direction: row;
      justify-content: flex-end;
    }
    .int-p {
      width: clamp(560px, 58vw, 930px);
      font-size: var(--body);
      line-height: var(--lhb);
      color: var(--muted);
      column-count: 2;
      column-gap: clamp(36px, 4.2vw, 67px);
      text-align: justify;
      hyphens: auto;
    }

    /* wspólne klocki desktop */
    .kmp-sec-head h2 {
      font-size: var(--h2);
      line-height: 1.12;
    }
    .kmp-ps {
      display: flex;
      flex-direction: column;
      gap: clamp(13px, 1.3vw, 21px);
    }
    .kmp-ps-sep {
      border-top: 1px dashed rgba(33, 29, 24, 0.28);
      padding-top: clamp(16px, 1.6vw, 26px);
    }
    .kmp-ps p {
      margin: 0;
      font-family: var(--font-body), sans-serif;
      font-size: var(--body);
      line-height: var(--lhb);
      color: var(--muted);
      text-align: justify;
      hyphens: auto;
    }
    .kmp-ps em {
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-weight: 600;
      font-size: calc(var(--body) + 1.5px);
      color: var(--sepia);
    }
    .kmp-card {
      padding: clamp(15px, 1.5vw, 24px) clamp(16px, 1.6vw, 26px);
      gap: 6px;
    }
    .kmp-card-k {
      font-size: var(--monos);
    }
    .kmp-card-t {
      font-size: var(--body);
      line-height: 1.55;
    }
    .kmp-badge {
      font-size: var(--monos);
      background: rgba(250, 247, 241, 0.92);
      border: 1px solid rgba(33, 29, 24, 0.18);
      padding: clamp(8px, 0.9vw, 14px) clamp(12px, 1.2vw, 19px);
    }

    /* ciesielstwo */
    .cies-grid {
      display: grid;
      grid-template-columns: 1.04fr 0.96fr;
      align-items: stretch;
    }
    .cies-txt {
      display: flex;
      flex-direction: column;
      gap: clamp(14px, 1.4vw, 22px);
      padding: 0 clamp(40px, 4.4vw, 70px) clamp(44px, 4.4vw, 70px) var(--g);
      box-sizing: border-box;
    }
    /* kicker+h2 płyną w kolumnie tekstu (mobile: pudło płyty z tłem) */
    .cies-head,
    .cies-head .kmp-sec-head-in {
      display: contents;
    }
    .cies-photo {
      position: relative;
      overflow: hidden;
      min-height: clamp(340px, 65vh, 560px);
    }
    .cies-photo > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 34% 46%;
      filter: sepia(0.24) saturate(0.82) contrast(1.05);
    }
    .cies-zakd {
      position: relative;
      max-width: var(--wmax);
      margin-inline: auto;
      box-sizing: border-box;
      width: 100%;
      padding: clamp(40px, 4vw, 64px) var(--g) clamp(70px, 7vw, 112px);
    }
    .zakd-rycw {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .zakd-rycw > img {
      position: absolute;
      right: -2.6vw;
      top: clamp(8px, 0.9vw, 14px);
      width: clamp(220px, 21vw, 336px);
      max-width: none;
      height: auto;
      opacity: 0.2;
      mix-blend-mode: multiply;
    }
    .zakd-in {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: clamp(13px, 1.3vw, 21px);
      max-width: clamp(640px, 68vw, 1088px);
    }
    .cies-zakd .kmp-cards {
      grid-template-columns: 1fr 1fr;
      gap: clamp(11px, 1.1vw, 18px);
    }

    /* murarstwo */
    .mur-moz {
      display: grid;
      grid-template-columns: 1.32fr 0.68fr;
      align-items: stretch;
    }
    .moz-a,
    .moz-b {
      position: relative;
      overflow: hidden;
      height: clamp(300px, 53vh, 460px);
    }
    .moz-b {
      border-left: 1px solid rgba(250, 247, 241, 0.5);
    }
    .mur-moz img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: sepia(0.24) saturate(0.82) contrast(1.05);
    }
    .moz-a img {
      object-position: 48% 46%;
    }
    .moz-b img {
      object-position: 58% 50%;
    }
    .mur-head {
      overflow: visible;
      max-width: var(--wmax);
      margin: calc(-1 * clamp(58px, 6vw, 96px)) auto 0;
      box-sizing: border-box;
      width: 100%;
      padding: 0 var(--g);
      z-index: 2;
    }
    .mur-head .kmp-sec-head-in {
      max-width: clamp(560px, 58vw, 928px);
      margin: 0;
      padding: clamp(30px, 3vw, 48px) clamp(30px, 3.2vw, 51px);
      gap: clamp(11px, 1.1vw, 18px);
      background: var(--bg-cream);
      border: 1px solid rgba(33, 29, 24, 0.18);
      box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
    }
    .mur-grid {
      position: relative;
      max-width: var(--wmax);
      margin-inline: auto;
      box-sizing: border-box;
      width: 100%;
      padding: clamp(44px, 4.4vw, 70px) var(--g) clamp(70px, 7vw, 112px);
      display: grid;
      grid-template-columns: 1.06fr 0.94fr;
      gap: clamp(40px, 5.56vw, 89px);
      align-items: start;
    }
    .mur-rycw {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .mur-rycw > img {
      position: absolute;
      left: -3.2vw;
      bottom: clamp(-24px, -2.4vw, -16px);
      width: clamp(220px, 21vw, 336px);
      max-width: none;
      height: auto;
      opacity: 0.2;
      mix-blend-mode: multiply;
    }
    .mur-zak {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: clamp(9px, 0.9vw, 14px);
    }
    .mur-zak .kmp-card {
      padding: clamp(13px, 1.3vw, 21px) clamp(16px, 1.6vw, 26px);
      gap: 5px;
    }

    /* sklepienia */
    .skl-grid {
      display: grid;
      grid-template-columns: 1.04fr 0.96fr;
      align-items: stretch;
      padding: 0 0 clamp(54px, 5.4vw, 86px);
    }
    .skl-photo {
      position: relative;
      overflow: hidden;
      min-height: clamp(330px, 60vh, 520px);
    }
    .skl-photo > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 46%;
      filter: sepia(0.24) saturate(0.82) contrast(1.05);
    }
    .skl-badge {
      left: 0;
      bottom: 0;
      background: rgba(250, 247, 241, 0.94);
      border: 0;
      border-top: 1px solid rgba(33, 29, 24, 0.18);
      border-right: 1px solid rgba(33, 29, 24, 0.18);
      padding: clamp(9px, 0.9vw, 14px) clamp(14px, 1.4vw, 22px);
    }
    .skl-side {
      position: relative;
      display: flex;
      align-items: center;
      padding: 0 var(--g) 0 clamp(34px, 3.8vw, 60px);
      box-sizing: border-box;
    }
    .skl-rycw {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .skl-rycw > img {
      position: absolute;
      right: -3vw;
      bottom: clamp(-26px, -2.6vw, -18px);
      width: clamp(220px, 21vw, 336px);
      max-width: none;
      height: auto;
      opacity: 0.2;
      mix-blend-mode: multiply;
    }
    .skl-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid rgba(33, 29, 24, 0.18);
      box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
      padding: clamp(34px, 3.4vw, 54px) clamp(26px, 2.8vw, 45px);
      display: flex;
      flex-direction: column;
      gap: clamp(15px, 1.5vw, 24px);
    }
    .skl-head,
    .skl-head .kmp-sec-head-in {
      display: contents;
    }
    .kmp-skl .kmp-ps-sep {
      padding-top: clamp(16px, 1.6vw, 26px);
    }
    .kmp-skl .kmp-ps {
      gap: clamp(14px, 1.4vw, 22px);
    }

    /* tworzymy i odtwarzamy — ciemny pas */
    .kmp-two {
      background: #211d18;
    }
    .two-in {
      max-width: var(--wmax);
      margin-inline: auto;
      box-sizing: border-box;
      width: 100%;
      padding: clamp(44px, 4.4vw, 70px) var(--g) clamp(48px, 4.8vw, 77px);
      display: flex;
      flex-direction: column;
      gap: clamp(20px, 2vw, 32px);
    }
    .two-kick {
      color: rgba(245, 239, 227, 0.72);
    }
    .two-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }
    .two-col {
      padding: 0 clamp(14px, 1.5vw, 24px);
      border-left: 1px solid rgba(245, 239, 227, 0.22);
      display: flex;
      flex-direction: column;
      gap: clamp(10px, 1vw, 16px);
    }
    .two-col:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .two-col:last-child {
      padding-right: 0;
    }
    .two-col .two-num {
      font-size: var(--monos);
      color: rgba(160, 177, 140, 0.95);
    }
    .two-col .two-name {
      font-size: clamp(19px, 1.6vw, 26px);
      line-height: 1.2;
      color: #f5efe3;
    }

    /* fizyka budowli */
    .eko-grid {
      display: grid;
      grid-template-columns: 0.6fr 0.4fr;
      padding: 0 0 clamp(60px, 6vw, 96px);
    }
    .eko-photo {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: relative;
      overflow: hidden;
      min-height: clamp(320px, 62vh, 560px);
    }
    .eko-photo > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 48% 58%;
      filter: sepia(0.24) saturate(0.82) contrast(1.05);
    }
    .eko-badge {
      left: clamp(24px, 2.4vw, 38px);
      top: clamp(24px, 2.4vw, 38px);
      max-width: clamp(220px, 22vw, 352px);
      color: rgba(33, 29, 24, 0.68);
    }
    .eko-txt {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      margin: 0;
      padding: clamp(64px, 6.6vw, 106px) var(--g) clamp(30px, 3.2vw, 51px)
        clamp(40px, 4.4vw, 70px);
      gap: clamp(16px, 1.7vw, 27px);
    }
    .kmp-eko h2 {
      font-size: var(--h2);
      line-height: 1.12;
    }
    .eko-pw {
      margin: 0;
      border-top: 1px dashed rgba(33, 29, 24, 0.28);
      padding-top: clamp(16px, 1.7vw, 27px);
    }
    .eko-p {
      font-size: var(--body);
      line-height: var(--lhb);
    }
    .eko-card {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      z-index: 2;
      width: auto;
      max-width: none;
      margin: 0 var(--g) 0 calc(-1 * clamp(80px, 8.4vw, 134px));
      padding: clamp(24px, 2.6vw, 42px) clamp(26px, 2.6vw, 42px);
      gap: clamp(11px, 1.2vw, 19px);
    }
    .eko-card-k {
      font-size: var(--mono);
    }
    .eko-card-t {
      font-size: var(--body);
    }
    .eko-card .kmp-btn {
      font-size: clamp(14px, 1.05vw, 17px);
      padding: clamp(12px, 1.3vw, 21px) clamp(22px, 2.2vw, 35px);
    }

    /* instalacje */
    .inst-grid {
      display: grid;
      grid-template-columns: 0.46fr 0.54fr;
      align-items: start;
      padding: 0 0 2vh;
    }
    .inst-photo {
      position: relative;
      overflow: hidden;
      min-height: clamp(260px, 50vh, 660px);
    }
    .inst-photo > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 42%;
      filter: sepia(0.52) saturate(0.95) contrast(1.03);
    }
    .inst-badge {
      left: clamp(20px, 2vw, 32px);
      bottom: clamp(20px, 2vw, 32px);
    }
    .inst-panel {
      z-index: 2;
      margin: 4.6vh var(--g) 0 calc(-1 * clamp(70px, 7.4vw, 118px));
      background: var(--bg-cream);
      border: 1px solid rgba(33, 29, 24, 0.18);
      box-shadow: 0 1px 3px rgba(33, 29, 24, 0.08);
      padding: 3.4vh clamp(34px, 3.6vw, 58px);
      display: flex;
      flex-direction: column;
      gap: clamp(12px, 1.3vw, 21px);
    }
    .inst-rycw {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .inst-rycw > img {
      position: absolute;
      right: -6vw;
      bottom: clamp(-20px, -1.6vw, -12px);
      width: clamp(220px, 21vw, 336px);
      max-width: none;
      height: auto;
