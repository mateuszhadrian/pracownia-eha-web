    }
    html.js-motion .kmp [data-rycsb="r"].in {
      animation: kmpRycR 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty masek „rysowania" (eksport: klin 105°/255° + smugi) */
  .kmp {
    --ryc-wedge-l: linear-gradient(105deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-l: linear-gradient(
      105deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
    --ryc-lines-r: linear-gradient(
      255deg,
      rgba(0, 0, 0, 0) 0 34%,
