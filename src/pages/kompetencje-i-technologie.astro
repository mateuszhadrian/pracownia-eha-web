---
// Podstrona /kompetencje-i-technologie/ (Etap 4.4, część 2) — port
// docs/design/export/kompetencje-i-technologie.html; decyzje:
// docs/analiza-kompetencje.md. Konsumuje moduły części 1 BEZ zmian ich
// mechanik: CollapsibleText + collapsible.ts (zwijane akapity mobile,
// progressive enhancement jak paginacja E5 — SSR z pełnym tekstem),
// content-motion.ts (reveale/rysowanie/parallaxy/dryf tła za bramką
// js-motion), Navbar tone="dark" (kremowy pasek nad hero z górnym
// gradientem), PaperBackdrop. Sekcje rzemiosł (ciesielstwo/murarstwo/
// sklepienia) mają na obu progach REALNIE różne kompozycje (analiza §2
// pkt 5) — akapity/kadry/karty są świadomie zduplikowane dOnly/mOnly
// (kicker+h2 wspólne); fizyka/instalacje/granice = jeden markup.
import ceglaMoz from "@/assets/cegla-i-kamien.webp";
import ceglaAi1 from "@/assets/cegla-i-kamien-ai1.webp";
import cegla2 from "@/assets/cegla-i-kamien2-full.webp";
import cegla3 from "@/assets/cegla-i-kamien3.webp";
import czernica from "@/assets/czernica-elewacja-szachulcowa-3.webp";
import house2 from "@/assets/dom-ryc-house2.webp";
import house3 from "@/assets/dom-ryc-house3.webp";
import house4 from "@/assets/dom-ryc-house4.webp";
import house5 from "@/assets/dom-ryc-house5.webp";
import house6 from "@/assets/dom-ryc-house6.webp";
import house7 from "@/assets/dom-ryc-house7.webp";
import ekologia from "@/assets/ekologia-techno.webp";
import hero from "@/assets/kompetencje-i-technologie-hero.webp";
import hydraulika from "@/assets/hydraulika-elektryka-ai.webp";
import instalacjeKadr from "@/assets/instalacje-full.webp";
import instalacjePol from "@/assets/instalacje.webp";
import murAi1 from "@/assets/mur-szachulcowy-ai1.webp";
import murAi2 from "@/assets/mur-szachulcowy-ai2.webp";
import murFull from "@/assets/mur-szachulcowy-full.webp";
import naglowek from "@/assets/naglowek-ost-sekcja-techn.webp";
import podlogowka from "@/assets/podlogowka.webp";
import rozdzielnica from "@/assets/rozdzielnica.webp";
import sklepieniaAi from "@/assets/sklepienia-ai1.webp";
import sklepienie from "@/assets/sklepienie-zagliste-full.webp";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import PaperBackdrop from "@/components/PaperBackdrop.astro";
import CollapsibleText from "@/components/sections/CollapsibleText.astro";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONTACT_PATH, TRADYCJA_PATH } from "@/lib/routes";

// Treści powtarzane dOnly/mOnly — jedno źródło, żeby kopie nie mogły
// się rozjechać (akapity z <em> siedzą inline w markupie).
const CIES_P = [
  "Traktujemy drewno z szacunkiem, jakiego wymaga historyczna substancja. Specjalizujemy się w ratowaniu, odbudowie i wznoszeniu od podstaw skomplikowanych konstrukcji drewnianych. Nie uznajemy współczesnych ułatwień w postaci metalowych łączników czy śrub tam, gdzie tradycja wymaga innej techniki.",
  "Ściany i elementy nośne łączymy wyłącznie za pomocą precyzyjnie wykonanych, tradycyjnych złączy ciesielskich oraz drewnianych kołków. To właśnie ta ortodoksja technologiczna gwarantuje statykę i elastyczność budynków na kolejne stulecia. Niejednokrotnie integrujemy też stare, wiekowe drewno z nowym, odpowiednio wyselekcjonowanym materiałem.",
];
const MUR_P = [
  "Fundamenty, ściany nośne i mury to kręgosłup każdego starego domu. Pracujemy z wymagającymi materiałami: kamieniem naturalnym, nową cegłą oraz historyczną cegłą z rozbiórki. Rozumiemy chemię starych zapraw i wiemy, jak zachowuje się mur obciążony upływem czasu.",
  "Nasze prace murarskie to nie tylko układanie materiału, ale przede wszystkim przywracanie budynkom ich pierwotnej geometrii i wytrzymałości.",
];
const SKL_P2 =
  "Tam, gdzie inne ekipy rezygnują z obawy przed skomplikowanym rozkładem sił i wektorów, my z pasją odtwarzamy historyczne ustroje nośne. Wykonujemy je z niesamowitą dbałością o detal, przywracając wnętrzom ich dawny, monumentalny charakter.";
const CIES_CARDS = [
  {
    k: "MURY SZACHULCOWE I PRUSKIE",
    t: "Budowa i renowacja w ustroju słupowo-ryglowym.",
  },
  { k: "KONSTRUKCJE PRZYSŁUPOWE", t: "Odtwarzanie i wznoszenie od podstaw." },
  {
    k: "WIĘŹBY DACHOWE",
    t: "Wykonywanie więźb dachowych. Zarówno proste jak i skomplikowane projekty.",
  },
  {
    k: "ELEMENTY KONSTRUKCYJNE",
    t: "Prace przy małych i średnich elementach konstrukcyjnych.",
  },
];
const MUR_CARDS = [
  {
    k: "MURY Z KAMIENIA I CEGŁY",
    t: "Wznoszenie i renowacja murów — także z historycznej cegły rozbiórkowej.",
  },
  {
    k: "FUGOWANIE HISTORYCZNYCH SPOIN",
    t: "Precyzyjne odtwarzanie i uzupełnianie spoin starych murów.",
  },
  { k: "ŁUKI I NADPROŻA", t: "Murowanie łuków nadproży, okien i drzwi." },
  { k: "TYNKI TRADYCYJNE", t: "Kładzenie tynków metodami tradycyjnymi." },
];
const TWORZYMY = [
  "Sklepienia kolebkowe",
  "Sklepienia żagliste",
  "Sklepienia krzyżowo-żebrowe",
  "Kopuły we wszelkim kształcie",
  "Stropy odcinkowe",
];
const SKL_BADGE = "SKLEPIENIA ŻAGLISTE — REALIZACJA EH/A";
---

<BaseLayout
  title={ui.pl["kompetencjePage.title"]}
  description={ui.pl["kompetencjePage.description"]}
>
  <script is:inline slot="head">
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów/rysowania — reszta w content-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar tone="dark" />

  <main class="kmp">
    <PaperBackdrop />

    {/* ── hero + płyta tytułowa: grid-overlap, JEDEN h1 (analiza §2.4) ── */}
    <header class="kmp-head">
      <div class="kmp-hero-ph" data-navref>
        <img
          data-plx
          src={hero.src}
          width={hero.width}
          height={hero.height}
          alt="Rysunek techniczny konstrukcji i fotografia wnętrza stodoły"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {/* gradient czytelności kremowego paska (tone="dark") */}
        <span class="kmp-hero-top" aria-hidden="true"></span>
      </div>
      <div class="kmp-tt">
        <h1>Kompetencje i technologie.</h1>
        <p class="kmp-lead dOnly">Inżynieria tradycji.</p>
      </div>
    </header>

    {/* ── akapit wprowadzający ── */}
    <section class="kmp-intro">
      <div class="int-rycw dOnly" aria-hidden="true">
        <img
          data-rycsb="l"
          src={house6.src}
          width={house6.width}
          height={house6.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="int-in">
        <p class="kmp-lead mOnly">Inżynieria tradycji.</p>
        <p class="int-p">
          W Pracowni EH/A nie idziemy na kompromisy. Budownictwo historyczne
          wymaga pokory, inżynieryjnej precyzji i technologii, które przetrwały
          wieki. Nasze kompetencje opierają się na głębokim zrozumieniu materii
          – od statyki murów, przez fizykę drewna, aż po skomplikowane ustroje
          nośne. Dzielimy nasze rzemiosło na dwie równorzędne dziedziny:
          tradycyjne ciesielstwo oraz zaawansowane murarstwo, łącząc je ze
          współczesną funkcjonalnością.
        </p>
      </div>
    </section>

    {/* ── CIESIELSTWO ── */}
    <section class="kmp-cies">
      <div class="cies-grid">
        <div class="cies-txt">
          <div class="kmp-sec-head cies-head">
            <div class="kmp-plbg mOnly" aria-hidden="true">
              <img
                data-plx
                src={murAi1.src}
                width={murAi1.width}
                height={murAi1.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="kmp-fog"></span>
            </div>
            <div class="kmp-sec-head-in">
              <h2 data-rev>Drewno. Ciesielstwo bez dróg na skróty</h2>
            </div>
          </div>
          <div class="kmp-ps kmp-ps-sep dOnly">
            {CIES_P.map((t) => <p>{t}</p>)}
          </div>
        </div>
        <div class="cies-photo dOnly">
          <img
            src={murFull.src}
            width={murFull.width}
            height={murFull.height}
            alt="Mur szachulcowy w trakcie prac ciesielskich"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <CollapsibleText
        id="sec-ciesielstwo"
        collapsedMax="132px"
        class="kmp-clp mOnly"
      >
        <div class="kmp-clp-ryc cies-ryc" aria-hidden="true">
          <img
            data-ryc="r"
            src={house6.src}
            width={house6.width}
            height={house6.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        {CIES_P.map((t) => <p>{t}</p>)}
        <div class="kmp-bandclp cies-band">
          <img
            data-plx
            src={murFull.src}
            width={murFull.width}
            height={murFull.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="kmp-zakm cies-zakm">
          <img
            class="zakm-bg"
            src={murAi2.src}
            width={murAi2.width}
            height={murAi2.height}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          <div class="zakm-in">
            <p class="kmp-kick">ZAKRES PRAC CIESIELSKICH</p>
            <div class="kmp-cards">
              {
                CIES_CARDS.map((c) => (
                  <div class="kmp-card">
                    <p class="kmp-card-k">{c.k}</p>
                    <p class="kmp-card-t">{c.t}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </CollapsibleText>
      <div class="cies-zakd dOnly">
        <div class="zakd-rycw" aria-hidden="true">
          <img
            data-rycsb="r"
            src={house6.src}
            width={house6.width}
            height={house6.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="zakd-in">
          <p class="kmp-kick">ZAKRES PRAC CIESIELSKICH</p>
          <div class="kmp-cards">
            {
              CIES_CARDS.map((c) => (
                <div class="kmp-card">
                  <p class="kmp-card-k">{c.k}</p>
                  <p class="kmp-card-t">{c.t}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* ── MURARSTWO ── */}
    <section class="kmp-mur">
      <div class="mur-moz dOnly">
        <div class="moz-a">
          <img
            src={cegla2.src}
            width={cegla2.width}
            height={cegla2.height}
            alt="Detal muru z cegły i kamienia"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="moz-b">
          <img
            src={ceglaMoz.src}
            width={ceglaMoz.width}
            height={ceglaMoz.height}
            alt="Ściana z kamienia naturalnego"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="kmp-sec-head mur-head">
        <div class="kmp-plbg mOnly" aria-hidden="true">
          <img
            data-plx
            src={ceglaAi1.src}
            width={ceglaAi1.width}
            height={ceglaAi1.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="kmp-fog"></span>
        </div>
        <div class="kmp-sec-head-in">
          <h2 data-rev>Cegła i kamień. Murarstwo z duszą</h2>
        </div>
      </div>
      <div class="mur-grid dOnly">
        <div class="mur-rycw" aria-hidden="true">
          <img
            data-rycsb="l"
            src={house6.src}
            width={house6.width}
            height={house6.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="kmp-ps">{MUR_P.map((t) => <p>{t}</p>)}</div>
        <div class="mur-zak">
          <p class="kmp-kick">ZAKRES PRAC MURARSKICH</p>
          {
            MUR_CARDS.map((c) => (
              <div class="kmp-card">
                <p class="kmp-card-k">{c.k}</p>
                <p class="kmp-card-t">{c.t}</p>
              </div>
            ))
          }
        </div>
      </div>
      <CollapsibleText
        id="sec-murarstwo"
        collapsedMax="132px"
        class="kmp-clp mOnly"
      >
        <div class="kmp-clp-ryc mur-ryc" aria-hidden="true">
          <img
            data-ryc="r"
            src={house3.src}
            width={house3.width}
            height={house3.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        {MUR_P.map((t) => <p>{t}</p>)}
        <div class="kmp-bandclp mur-band">
          <img
            data-plx
            src={cegla2.src}
            width={cegla2.width}
            height={cegla2.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="kmp-zakm mur-zakm">
          <img
            class="zakm-bg"
            src={cegla3.src}
            width={cegla3.width}
            height={cegla3.height}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          <div class="zakm-in">
            <p class="kmp-kick">ZAKRES PRAC MURARSKICH</p>
            <div class="kmp-cards">
              {
                MUR_CARDS.map((c) => (
                  <div class="kmp-card">
                    <p class="kmp-card-k">{c.k}</p>
                    <p class="kmp-card-t">{c.t}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </CollapsibleText>
    </section>

    {/* ── SKLEPIENIA ── */}
    <section class="kmp-skl">
      <div class="skl-grid">
        <div class="skl-photo dOnly">
          <img
            src={sklepienie.src}
            width={sklepienie.width}
            height={sklepienie.height}
            alt="Sklepienia żagliste w piwnicy — realizacja EH/A"
            loading="lazy"
            decoding="async"
          />
          <p class="kmp-badge skl-badge">{SKL_BADGE}</p>
        </div>
        <div class="skl-side">
          <div class="skl-rycw dOnly" aria-hidden="true">
            <img
              data-rycsb="r"
              src={house6.src}
              width={house6.width}
              height={house6.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="skl-card">
            <div class="kmp-sec-head skl-head">
              <div class="kmp-plbg mOnly" aria-hidden="true">
                <img
                  data-plx
                  src={sklepieniaAi.src}
                  width={sklepieniaAi.width}
                  height={sklepieniaAi.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="kmp-fog"></span>
              </div>
              <div class="kmp-sec-head-in">
                <h2 data-rev>Sklepienia. Korona naszego rzemiosła</h2>
              </div>
            </div>
            <div class="kmp-ps kmp-ps-sep dOnly">
              <p>
                To dziedzina, z której czerpiemy największą satysfakcję i która
                jest ostatecznym sprawdzianem murarskich kompetencji. W myśl
                zasady <em>„im trudniej, tym lepiej”</em>, podejmujemy się
                najbardziej skomplikowanych wyzwań inżynieryjnych i
                geometrycznych.
              </p>
              <p>{SKL_P2}</p>
            </div>
          </div>
        </div>
      </div>
      <CollapsibleText
        id="sec-sklepienia"
        collapsedMax="132px"
        class="kmp-clp mOnly"
      >
        <div class="kmp-clp-ryc skl-ryc" aria-hidden="true">
          <img
            data-ryc="r"
            src={house7.src}
            width={house7.width}
            height={house7.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <p>
          To dziedzina, z której czerpiemy największą satysfakcję i która jest
          ostatecznym sprawdzianem murarskich kompetencji. W myśl zasady <em
            >„im trudniej, tym lepiej”</em
          >, podejmujemy się najbardziej skomplikowanych wyzwań inżynieryjnych i
          geometrycznych.
        </p>
        <p>{SKL_P2}</p>
        <figure class="skl-kadr">
          <div class="kmp-bandclp skl-band">
            <img
              data-plx
              src={sklepienie.src}
              width={sklepienie.width}
              height={sklepienie.height}
              alt="Sklepienia żagliste w piwnicy — realizacja EH/A"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{SKL_BADGE}</figcaption>
        </figure>
        <div class="skl-twom">
          <p class="kmp-kick">TWORZYMY I ODTWARZAMY</p>
          <div class="kmp-cards">
            {
              TWORZYMY.map((name, i) => (
                <div class="two-card">
                  <span class="two-num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="two-name">{name}</span>
                </div>
              ))
            }
          </div>
        </div>
      </CollapsibleText>
    </section>

    {/* ── TWORZYMY I ODTWARZAMY: ciemny pas (desktop) ── */}
    <section class="kmp-two dOnly" aria-label="Tworzymy i odtwarzamy">
      <div class="two-in">
        <p class="kmp-kick two-kick">TWORZYMY I ODTWARZAMY</p>
        <div class="two-grid">
          {
            TWORZYMY.map((name, i) => (
              <div class="two-col">
                <span class="two-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="two-name">{name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── FIZYKA BUDOWLI ── */}
    <section class="kmp-eko">
      <div class="eko-strip mOnly" aria-hidden="true">
        <img
          src={ekologia.src}
          width={ekologia.width}
          height={ekologia.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="eko-grid">
        <div class="eko-photo dOnly">
          <img
            src={ekologia.src}
            width={ekologia.width}
            height={ekologia.height}
            alt="Wapień, wełna drzewna i stare drewno na warsztatowym blacie"
            loading="lazy"
            decoding="async"
          />
          <p class="kmp-badge eko-badge">
            WAPIEŃ, WEŁNA DRZEWNA I STARE DREWNO NA WARSZTATOWYM BLACIE
          </p>
        </div>
        <div class="eko-txt">
          <h2 data-rev>Fizyka budowli. Ekologia, która działa</h2>
          <div class="eko-pw">
            <div class="kmp-clp-ryc eko-ryc mOnly" aria-hidden="true">
              <img
                data-ryc="r"
                data-plxr
                src={house5.src}
                width={house5.width}
                height={house5.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="eko-p">
              Nasze podejście do ekologii nie opiera się na modnych hasłach,
              lecz na prawach fizyki i geologicznej wiedzy o materiałach.
              Dlatego każdy dobór warstw ocieplenia poprzedzamy szczegółowymi
              obliczeniami cieplno-wilgotnościowymi. Stosujemy ocieplenia i
              termomodernizacje budynków przy użyciu otwartych dyfuzyjnie
              materiałów, takich jak wełna drzewna czy tynki wapienne. Pozwala
              to historycznej tkance „oddychać”, naturalnie regulując wilgotność
              i chroniąc konstrukcję przed degradacją.
            </p>
          </div>
        </div>
        <div class="eko-card">
          <p class="eko-card-k">TRADYCJA I EKOLOGIA</p>
          <p class="eko-card-t">
            Zajrzyj głębiej: jak natura i stare technologie chronią Twój dom
            lepiej niż współczesna chemia.
          </p>
          <a class="kmp-btn" href={TRADYCJA_PATH}>Poznaj nasze podejście →</a>
        </div>
      </div>
    </section>

    {/* ── INSTALACJE ── */}
    <section class="kmp-inst">
      <div class="inst-grid">
        <div class="inst-photo dOnly">
          <img
            src={instalacjeKadr.src}
            width={instalacjeKadr.width}
            height={instalacjeKadr.height}
            alt="Rozdzielacz ogrzewania — realizacja EH/A"
            loading="lazy"
