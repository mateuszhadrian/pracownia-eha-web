  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna). Mobile: reveale + rysowanie rycin
     maską + parallaxy; desktop: rysowanie [data-rycsb] + dryf tła.
     Maska schodzi z elementu po animacji (content-motion.ts — lekcja
     D-Q1). Wzorce i wartości 1:1 z 4.2/4.3/4.4 cz. 1. ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .kmp [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .kmp [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .kmp [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .kmp [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .kmp [data-ryc="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
    }
    html.js-motion .kmp [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .kmp [data-ryc="l"].in {
      animation: kmpRycL 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    html.js-motion .kmp [data-ryc="r"].in {
      animation: kmpRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }
  @media (min-width: 1024px) {
    html.js-motion .kmp [data-rycsb] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .kmp [data-rycsb="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
