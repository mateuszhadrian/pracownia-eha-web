  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna i kompletna). Mobile: reveale +
     rysowanie rycin maską + parallaxy; desktop: rysowanie [data-rycsb]
     + dryf tła. Wzorce i wartości 1:1 z 4.2–4.5. ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .obs [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .obs [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .obs [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .obs [data-rev][data-rev-d="2"] {
      transition-delay: 0.18s;
    }
    html.js-motion .obs [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .obs [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .obs [data-ryc="r"].in {
      animation: obsRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }
  @media (min-width: 1024px) {
    html.js-motion .obs [data-rycsb] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .obs [data-rycsb="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
    }
    html.js-motion .obs [data-rycsb="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .obs [data-rycsb="l"].in {
      animation: obsRycL 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    html.js-motion .obs [data-rycsb="r"].in {
      animation: obsRycR 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty masek „rysowania" (eksport: klin 105°/255° + smugi) */
  .obs {
    --ryc-wedge-l: linear-gradient(105deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-l: linear-gradient(
      105deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
    --ryc-lines-r: linear-gradient(
      255deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
  }
  @keyframes obsRycL {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
      filter: opacity(1);
    }
  }
  @keyframes obsRycR {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
      filter: opacity(1);
    }
  }
