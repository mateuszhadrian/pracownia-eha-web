---
// Strona główna (Etap 4.2) — port docs/design/export/index.html; decyzje:
// docs/analiza-home.md. Hero z [data-navref] (Navbar 4.1 liczy z niego stan
// „solid"), 6 zajawek, stopka 4.1. Ruch (home-motion.ts) ładowany
// DYNAMICZNIE tylko przy motion OK; stany startowe animacji uzbraja klasa
// html.js-motion nadawana inline PRZED paintem — bez JS / przy reduce
// strona jest w pełni statyczna i kompletna (sections.md).
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import PaperBackdrop from "@/components/PaperBackdrop.astro";
import HomeEkipa from "@/components/sections/home/HomeEkipa.astro";
import HomeHero from "@/components/sections/home/HomeHero.astro";
import HomeKompetencje from "@/components/sections/home/HomeKompetencje.astro";
import HomeKontakt from "@/components/sections/home/HomeKontakt.astro";
import HomeObsluga from "@/components/sections/home/HomeObsluga.astro";
import HomeRealizacje from "@/components/sections/home/HomeRealizacje.astro";
import { homeRealizacje } from "@/components/sections/home/home-realizacje-data";
import HomeTradycja from "@/components/sections/home/HomeTradycja.astro";
import WorkDetail from "@/components/sections/work/WorkDetail.astro";
import WorkDetailOverlay from "@/components/sections/work/WorkDetailOverlay.astro";
import { ui } from "@/i18n/ui";
import JsonLd from "@/components/seo/JsonLd.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { webSite } from "@/lib/jsonld";

// Opis = lead hero (dotąd strona główna była bez description — szkielet).
const DESCRIPTION =
  "Ciesielstwo i murarstwo tradycyjne, tynki wapienne, wełna drzewna. " +
  "Prowadzimy całą inwestycję — od ekspertyzy po stan surowy zamknięty +.";

// Detal realizacji otwierany PROSTO z zajawki 02 (korekta Mateusza —
// unieważnia analiza-realizacje §2 pkt 4). Templaty i nakładka muszą stać
// POZA <main class="home">: `.home` ma isolation: isolate (PaperBackdrop),
// więc .dt-ov (z-index 100) trafiłby do JEGO kontekstu układania i pasek
// nawigacji (.hdr, z-index 50) malowałby się NA modalu. Ta sama lista co
// w kaflach — wspólne źródło home-realizacje-data.
const { shown: realizacje } = await homeRealizacje();

// Dane strukturalne (Etap 6): @graph z WebSite + SAMODZIELNĄ Organization.
// Bazą jest ZAWSZE Astro.site (produkcyjna domena z astro.config), a nie
// Astro.url jak canonical w BaseLayout: `@id` węzłów to identyfikator
// firmy, który ma być TEN SAM na produkcji, na preview i w dev — inaczej
// Organization z `/` i firma z `/kontakt/` przestałyby być tym samym bytem.
const jsonLd = webSite(Astro.site ?? Astro.url);
---

<BaseLayout title={ui.pl["meta.title"]} description={DESCRIPTION}>
  <script is:inline slot="head">
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów/rysowania — reszta w home-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>
  <JsonLd slot="head" data={jsonLd} />

  <Navbar />

  <main class="home">
    <PaperBackdrop />
    <HomeHero />
    <HomeEkipa />
    <HomeRealizacje />
    <HomeKompetencje />
    <HomeObsluga />
    <HomeTradycja />
    <HomeKontakt />
  </main>

  <Footer />

  {/* Treść detalu per realizacja — klonowana do #work-detail po kliknięciu. */}
  {
    realizacje.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail project={project} />
      </template>
    ))
  }
  <WorkDetailOverlay />
</BaseLayout>

<style is:global>
  /* ── Tokeny strony głównej (odczyty z eksportu — analiza H5).
     Mobile w bazie, desktop w @media 1024 (para: HOME_DESKTOP_MIN_PX). ── */
  .home {
    /* Wysokość viewportu dla sekcji: domyślnie czyste 100svh; gdy pasek
       URL przeglądarki rusza webview (Galaxy S20 FE — D-Q2), skrypt
       home-viewport.ts przypina wartość sprzed drgnięcia INLINE na main
       i sekcje przestają skakać w rytm paska. */
    --svh: 100svh;
    /* ── REGULACJA WIDOCZNOŚCI subtelnych rycin dekoracyjnych ──
       Mnożnik bazowych opacity z eksportu (0.12–0.18 przy sekcjach,
       mobile i desktop): 1 = wiernie jak w designie, 1.6 = obecne
       podbicie (decyzja Mateusza — „trochę bardziej widoczne, ale nie
       jak hero"). Skaluje wszystkie proporcjonalnie, więc głębia
       między warstwami zostaje; ryciny hero (opacity 1) i mocniejsze
       (≥0.24: telefon w karcie 06, warsztat/plan desktop) nie
       podlegają. Wartości sensowne: ~1.0–2.5. */
    --ryc-vis: 1.6;
    /* padding boczny i kolumna sekcji mobile */
    --sp: clamp(30px, 4.2vw, 44px);
    --smax: 660px;
    /* typografia wspólna */
    --eyebrow: clamp(10px, 1.4vw, 11.5px);
    --h2: clamp(40px, 5.6vw, 54px);
    --lead: clamp(19px, 2.7vw, 24px);
    --body: clamp(14.5px, 2.05vw, 17px);
    --lh-b: 1.7;
    --cta: clamp(15px, 2.1vw, 17px);
    --monos: clamp(10px, 1.25vw, 10.5px);
    --item: clamp(21px, 2.95vw, 25px);

    /* treść startuje pod paskiem fixed (4.1) */
    padding-top: var(--hdr-h);
    /* ryciny wystają za krawędzie — clip bez tworzenia scrollera */
    overflow-x: clip;
    /* kalibracja tła per widok (README designów): baza kremowa jak
       w eksporcie + duży skan papieru (PaperBackdrop — od 4.3 wspólny
       z /realizacje/, z-index -1 —
       stąd isolation); kafelek body zostaje pod chrome'em innych tras */
    position: relative;
    isolation: isolate;
    background: var(--bg-cream);
  }
  @media (min-width: 1024px) {
    .home {
      --eyebrow: clamp(10px, 0.76vw, 12px);
      --h2: clamp(31px, 2.78vw, 44px);
      --lead: clamp(17px, 1.46vw, 23px);
      --body: clamp(13.5px, 1.08vw, 17px);
      --lh-b: 1.72;
      --cta: clamp(13px, 1.01vw, 16px);
      --monos: clamp(10px, 0.66vw, 10.5px);
      --item: clamp(20px, 1.74vw, 27.5px);
      /* kolumna tekstu sekcji desktop (—col eksportów) */
      --col-w: clamp(374px, 36.1vw, 578px);
      --ctapy: clamp(12px, 1.04vw, 17px);
      --ctapx: clamp(19px, 1.67vw, 27px);
    }
  }

  /* warianty per breakpoint (wzorzec dOnly/mOnly ze stopki 4.1):
     chowamy wyłącznie po niewłaściwej stronie progu — bez `revert`,
     żeby nie kasować displayu nadanego klasą (flexowe CTA) */
  @media (max-width: 1023.98px) {
    .home .dOnly {
      display: none !important;
    }
  }
  @media (min-width: 1024px) {
    .home .mOnly {
      display: none !important;
    }
  }

  /* ── sekcja-ekran (eksport: secH = max(100vh, 550)) ── */
  .home .sec {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(var(--svh), 550px);
  }

  /* ── czwórka nagłówkowa (HomeSectionHead) ── */
  .home .s-eyebrow {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: var(--eyebrow);
    letter-spacing: 0.2em;
    color: rgba(87, 101, 74, 0.95);
  }
  .home .s-title {
    margin: 0;
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: var(--h2);
    line-height: 1.08;
    color: var(--ink);
    text-wrap: pretty;
  }
  .home .s-lead {
    margin: 0;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 500;
    font-size: var(--lead);
    line-height: 1.35;
    color: var(--sepia);
    text-wrap: pretty;
  }
  .home .s-body {
    margin: 4px 0 0;
    font-family: var(--font-body), sans-serif;
    font-size: var(--body);
    line-height: var(--lh-b);
    color: var(--muted);
    text-wrap: pretty;
  }
  .home .shead {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 1024px) {
    .home .shead {
      gap: clamp(10px, 0.97vw, 16px);
    }
    .home .s-title {
      line-height: 1.1;
    }
  }

  /* ── CTA hero ── */
  .home .cta-fill {
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(52px, 7vw, 60px);
    padding: 0 clamp(28px, 3.8vw, 38px);
    background: var(--ink);
    color: #f5efe3;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: var(--cta);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-radius: 3px;
    transition: background 0.2s ease;
  }
  .home .cta-fill:hover {
    background: #0f0c09;
  }
  .home .cta-line {
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: var(--cta);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(87, 101, 74, 0.4);
    padding-bottom: 3px;
    transition: color 0.2s ease;
  }
  .home .cta-line:hover {
    color: var(--accent-ink);
  }
  @media (min-width: 1024px) {
    .home .cta-fill {
      height: max(44px, clamp(46px, 3.75vw, 60px));
      padding: 0 clamp(22px, 2.08vw, 33px);
    }
  }

  /* ── pasek CTA zajawki (mobile, pełna szerokość) ── */
  .home .zaj-bar {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: clamp(22px, 2.9vw, 28px) var(--sp);
    background: #3a3428;
    color: #f5efe3;
    text-decoration: none;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: var(--cta);
    letter-spacing: 0.01em;
    transition: background 0.2s ease;
  }
  .home .zaj-bar:hover {
    background: #2e2920;
  }
  .home .zaj-arr {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(245, 239, 227, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── CTA obrysowe (desktop) ── */
  .home .zaj-out {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: 11px;
    padding: var(--ctapy, 14px) var(--ctapx, 22px);
    border: 1px solid rgba(87, 101, 74, 0.55);
    color: var(--accent);
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: var(--cta);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .home .zaj-out:hover {
    background: rgba(87, 101, 74, 0.09);
    color: var(--accent-ink);
  }
  .home .zaj-out svg {
    flex: none;
  }

  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna). Mobile: reveale + rysowanie rycin
     maską + kołek; desktop: rysowanie [data-rycsb]. Maska schodzi
     z elementu po animacji (home-motion.ts — lekcja D-Q1). ═══ */
  @media (max-width: 1023.98px) {
    /* Reveale tekstów: PRZEJŚCIA w tempie delung (korekta Mateusza —
       eksportowe 0.68 s/10 px odbierane jako migotanie), z zachowaną
       kaskadą czwórki nagłówkowej przez transition-delay. */
    html.js-motion .home [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion .home [data-rev].in {
      opacity: 1;
      transform: none;
    }
    html.js-motion .home [data-rev][data-rev-d="1"] {
      transition-delay: 0.09s;
    }
    html.js-motion .home [data-rev][data-rev-d="2"] {
      transition-delay: 0.18s;
    }
    html.js-motion .home [data-rev][data-rev-d="3"] {
      transition-delay: 0.27s;
    }
    html.js-motion .home [data-ryc] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .home [data-ryc="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
    }
    html.js-motion .home [data-ryc="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .home [data-ryc="l"].in {
      animation: hmRycL 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    html.js-motion .home [data-ryc="r"].in {
      animation: hmRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    /* sekwencja rycin hero po wejściu (data-ryc-auto — HomeHero):
       etap 0 od razu, etap 1 po sekundzie, etap 2 po dwóch */
    html.js-motion .home [data-ryc][data-ryc-auto="1"].in {
      animation-delay: 1s;
    }
    html.js-motion .home [data-ryc][data-ryc-auto="2"].in {
      animation-delay: 2s;
    }
  }
  @media (min-width: 1024px) {
    html.js-motion .home [data-rycsb] {
      -webkit-mask-repeat: no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat;
      -webkit-mask-size:
        280% 100%,
        240% 100%;
      mask-size:
        280% 100%,
        240% 100%;
    }
    html.js-motion .home [data-rycsb="l"] {
      -webkit-mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      mask-image: var(--ryc-wedge-l), var(--ryc-lines-l);
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
    }
    html.js-motion .home [data-rycsb="r"] {
      -webkit-mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      mask-image: var(--ryc-wedge-r), var(--ryc-lines-r);
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .home [data-rycsb="l"].in {
      animation: hmRycL 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
    html.js-motion .home [data-rycsb="r"].in {
      animation: hmRycR 2s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty masek „rysowania" (eksport: klin 105°/255° + smugi) */
  .home {
    --ryc-wedge-l: linear-gradient(105deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-wedge-r: linear-gradient(255deg, #000 40%, rgba(0, 0, 0, 0) 52%);
    --ryc-lines-l: linear-gradient(
      105deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
    --ryc-lines-r: linear-gradient(
      255deg,
      rgba(0, 0, 0, 0) 0 34%,
      rgba(0, 0, 0, 0.85) 34% 36.5%,
      rgba(0, 0, 0, 0) 36.5% 40%,
      rgba(0, 0, 0, 0.85) 40% 42.5%,
      rgba(0, 0, 0, 0) 42.5% 46.5%,
      rgba(0, 0, 0, 0.85) 46.5% 49%,
      rgba(0, 0, 0, 0) 49% 100%
    );
  }

  @keyframes hmRycL {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
      filter: opacity(1);
    }
  }
  @keyframes hmRycR {
    0% {
      filter: opacity(0.55);
    }
    75% {
      filter: opacity(0.85);
    }
    100% {
      -webkit-mask-position:
        100% 0,
        100% 0;
      mask-position:
        100% 0,
        100% 0;
      filter: opacity(1);
    }
  }
</style>

<script>
  import { armViewportPin } from "@/components/sections/home/home-viewport";

  // Stabilność layoutu przy chowanym pasku URL (D-Q2) — ZAWSZE, to nie
  // dekoracja; przypina --svh dopiero, gdy sonda wykryje ruchome webview.
  armViewportPin();

  // Ruch strony głównej — dynamicznie, tylko przy motion OK (sections.md).
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("@/components/sections/home/home-motion");
  }
</script>
