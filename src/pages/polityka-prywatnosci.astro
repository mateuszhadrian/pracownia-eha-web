      -webkit-mask-position:
        0 0,
        0 0;
      mask-position:
        0 0,
        0 0;
    }
    html.js-motion .pp [data-ryc="r"].in {
      animation: ppRycR 2.8s cubic-bezier(0.3, 0.05, 0.25, 1) both;
    }
  }

  /* gradienty masek „rysowania" (eksport: klin 255° + smugi) */
  .pp {
