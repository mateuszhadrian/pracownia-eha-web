  /* ═══ RUCH (bramka js-motion; bez JS / przy reduce brak stanów
     startowych = strona statyczna i kompletna). Mobile: reveale +
     rysowanie rycin maską + parallax rycin; desktop: wyłącznie dryf
     tła (eksport nie ma tu ani jednego `rycsb`). Wzorce i wartości
     1:1 z 4.2–4.5. ═══ */
  @media (max-width: 1023.98px) {
    html.js-motion .pp [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
