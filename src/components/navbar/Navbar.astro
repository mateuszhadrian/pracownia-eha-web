---
// Chrome globalny eha (Etap 4.1, docs/analiza-chrome.md): pasek FIXED
// nakładkowy wg designów — desktop z dropdownem „O nas" i AUTO-HIDE (E11),
// mobile z glow czytelności (bez auto-hide — wzorzec 8/8 eksportów) oraz
// menu mobilnym jako bottom sheet na szkielecie scripts/overlay.ts
// (focus-trap, Esc, scrim, swipe-down `touch*` — mechanika z kopii delung,
// NIE ruszać). Skin „papier/atrament" wg eksportów; stany paska:
// [data-solid] (papierowe tło+cień po zjechaniu z góry), [data-hidden]
// (schowany auto-hide), [data-onas] (dropdown otwarty), [data-open] (sheet).
import { ABOUT_LABEL, aboutNavItems, mainNavItems } from "@/i18n/nav";
import { CONTACT_PATH, HOME_PATH } from "@/lib/routes";
import logoSign from "@/assets/logo/eha-logo-sign.svg";
import sheetRyc from "@/assets/dom-ryc-house1.webp";

// Normalizacja ukośnika — w dev Astro.url.pathname bywa bez końcowego "/".
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const t = {
  nav: "Główna nawigacja",
  mobileNav: "Menu mobilne",
  openMenu: "Otwórz menu",
  closeMenu: "Zamknij menu",
  menu: "Menu",
  call: "Zadzwoń do nas",
  home: "Pracownia EH/A — strona główna",
};
---

<header class="hdr" data-nav>
  {/* glow czytelności (mobile) — opacity steruje pętla rAF w skrypcie */}
  <span class="hdr-glow" aria-hidden="true"></span>
  {/* papierowe tło stanu solid (desktop) */}
  <span class="hdr-bg" aria-hidden="true"></span>

  {
    /* znaczek jako maska CSS na jednym cache'owanym SVG (nie inline —
      22 KB wektora nie może siedzieć w każdym HTML-u); kolor = background */
  }
  <a
    class="hdr-logo"
    href={HOME_PATH}
    aria-label={t.home}
    style={`--sign:url('${logoSign.src}')`}
  >
    <span class="hdr-sign" aria-hidden="true"></span>
  </a>

  <nav class="hdr-nav" aria-label={t.nav}>
    <div class="nav-about" data-dropdown>
      <button
        class="nav-link nav-about-btn"
        type="button"
        data-dropdown-toggle
        aria-expanded="false"
        aria-controls="nav-about-panel"
      >
        {ABOUT_LABEL}
        <svg class="chev" viewBox="0 0 13 8" aria-hidden="true">
          <path
            d="M1 1l5.5 5.5L12 1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path>
        </svg>
      </button>
      <div class="nav-drop" id="nav-about-panel" data-dropdown-panel hidden>
        {
          aboutNavItems.map((item) => (
            <a
              class="drop-link"
              href={item.href}
              aria-current={item.href === currentPath ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
    {
      mainNavItems.map((item) => (
        <a
          class="nav-link"
          href={item.href}
          aria-current={item.href === currentPath ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <button
    class="mbtn"
    type="button"
    data-burger
    aria-expanded="false"
    aria-controls="nav-sheet"
    aria-label={t.openMenu}
    data-open-label={t.openMenu}
    data-close-label={t.closeMenu}
  >
    <i aria-hidden="true"><b></b><b></b></i>
  </button>
</header>

{/* Bottom sheet menu — kontrakt overlay.ts (portalowany do <body>). */}
<div
  class="sheet-ov"
  id="nav-sheet"
  data-overlay
  data-overlay-kind="sheet"
  role="dialog"
  aria-modal="true"
  aria-label={t.menu}
  hidden
>
  <div class="sheet" data-overlay-panel tabindex="-1">
    {
      /* lazy: nakładka startuje [hidden], więc rycina nie pobiera się,
         dopóki sheet nie zostanie otwarty (desktop nie płaci za nią wcale) */
    }
    <img
      class="sheet-ryc"
      src={sheetRyc.src}
      width={sheetRyc.width}
      height={sheetRyc.height}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <div class="sheet-in" data-overlay-scroll>
      <div class="sheet-head" data-overlay-drag>
        <span class="sheet-grab" aria-hidden="true"></span>
      </div>
      <nav aria-label={t.mobileNav}>
        <div class="m-acc">
          <button
            class="m-link m-acc-btn"
            type="button"
            data-acc-toggle
            aria-expanded="false"
            aria-controls="sheet-about"
          >
            {ABOUT_LABEL}
            <svg class="m-chev" viewBox="0 0 13 8" aria-hidden="true">
              <path
                d="M1 1l5.5 5.5L12 1"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"></path>
            </svg>
          </button>
          <div class="m-sub" id="sheet-about" data-acc-panel>
            {
              aboutNavItems.map((item) => (
                <a
                  class="m-sub-link"
                  href={item.href}
                  aria-current={item.href === currentPath ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
        {
          mainNavItems.map((item) => (
            <a
              class="m-link"
              href={item.href}
              aria-current={item.href === currentPath ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="sheet-call">
        {
          /* dwa telefony MACIEK/ŁUKASZ — numery i href składane w JS
             (antyscraping); etykieta imienia zostaje w SSR, numer idzie
             do [data-slot] (lib/contact-details) */
        }
        <a data-tel="maciek" href={CONTACT_PATH} hidden>
          <b>Maciek</b>
          <span data-slot>Telefon</span>
        </a>
        <a data-tel="lukasz" href={CONTACT_PATH} hidden>
          <b>Łukasz</b>
          <span data-slot>Telefon</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── pasek ──
     Kolory chrome'u NIEZALEŻNE od tokenów strony — pasek ma wyglądać
     identycznie na każdym widoku (D-CH9); paleta z eksportów designów. */
  .hdr {
    --hdr-ink: #211d18;
    --hdr-paper: #faf7f1;
    --hdr-accent: #57654a;
    --hdr-accent-ink: #414d37;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--hdr-h);
    padding-inline: var(--pad);
    /* auto-hide (desktop) + wjazd tła: pasek animuje transform/opacity */
    transition:
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.26s ease;
  }
  .hdr[data-hidden] {
    transform: translateY(-125%);
    opacity: 0;
    pointer-events: none;
  }

  /* glow czytelności (mobile): gradient papieru + blur, maskowany w dół.
     Opacity ustawia pętla rAF (0 na górze strony → 0.85 po ~130 px). */
  .hdr-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 160px;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      rgba(250, 247, 241, 0.92) 0%,
      rgba(250, 247, 241, 0.86) 55%,
      rgba(250, 247, 241, 0) 100%
    );
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
    -webkit-mask-image: linear-gradient(#000 15%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(#000 15%, rgba(0, 0, 0, 0) 100%);
  }
  .hdr-bg {
    display: none;
  }

  .hdr-logo {
    position: relative;
    display: block;
    flex: none;
    width: 48px;
    color: #4c3b2b; /* sepia znaczka z designu */
  }
  .hdr-logo:focus-visible {
    outline: 2px solid var(--hdr-ink);
    outline-offset: 4px;
  }
  .hdr-sign {
    display: block;
    width: 100%;
    /* proporcje viewBoxu eha-logo-sign.svg (2836×2832) */
    aspect-ratio: 2836 / 2832;
    background: currentColor;
    -webkit-mask: var(--sign) no-repeat center / contain;
    mask: var(--sign) no-repeat center / contain;
  }

  .hdr-nav {
    display: none;
  }

  /* ── przycisk menu (mobile): 2 kreski → X ── */
  .mbtn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin-right: -11px;
    padding: 0;
    background: none;
    border: none;
    color: var(--hdr-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mbtn:focus-visible {
    outline: 2px solid var(--hdr-ink);
    outline-offset: 2px;
  }
  .mbtn i {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }
  .mbtn i b {
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mbtn i b:nth-child(1) {
    top: 3px;
  }
  .mbtn i b:nth-child(2) {
    top: 13px;
  }
  .hdr[data-open] .mbtn i b:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .hdr[data-open] .mbtn i b:nth-child(2) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* ── bottom sheet menu (skin „papier" wg designu) ── */
  .sheet-ov {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(33, 29, 24, 0.34);
    opacity: 0;
    transition: opacity 0.34s ease;
  }
  .sheet-ov[hidden] {
    display: none;
  }
  .sheet-ov.is-open {
    opacity: 1;
  }

  .sheet {
    position: relative;
    width: 100%;
    border-radius: 20px 20px 0 0;
    overflow: hidden;
    /* papier + kafelek przygaszony do ~.22 (poziom tekstury z designu) */
    background:
      linear-gradient(rgba(250, 247, 241, 0.78), rgba(250, 247, 241, 0.78)),
      url("../../assets/paper-tile.webp") repeat #faf7f1;
    box-shadow: 0 -14px 44px rgba(24, 19, 14, 0.26);
    /* grab + pierwszy link zawsze widoczne — zapas na notch (safe-area)
       i dynamiczny pasek przeglądarki (svh). */
    max-height: 92vh;
    max-height: min(92svh, calc(100svh - env(safe-area-inset-top, 0px) - 20px));
    display: flex;
    transform: translateY(105%);
    transition: transform 0.44s cubic-bezier(0.32, 0.72, 0.28, 1);
  }
  .sheet-ov.is-open .sheet {
    transform: none;
  }
  /* Panel bywa programowo fokusowany przy otwarciu dotykiem (tabindex=-1) —
     bez pierścienia; to kontener, nie kontrolka. */
  .sheet:focus {
    outline: none;
  }
  .sheet-ryc {
    position: absolute;
    right: -18px;
    bottom: -10px;
    width: 168px;
    height: auto;
    opacity: 0.28;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .sheet-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding: 0 var(--pad) calc(34px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .sheet-head {
    /* strefa chwytu gestu swipe-down — pełna szerokość, powiększona;
       touch-action:none blokuje natywny scroll podczas gestu. */
    padding: 9px 0 0;
    touch-action: none;
    cursor: grab;
  }
  .sheet-head:active {
    cursor: grabbing;
  }
  .sheet-grab {
    display: block;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: rgba(33, 29, 24, 0.22);
    margin: 0 auto 14px;
  }
  .sheet-in nav {
    display: flex;
    flex-direction: column;
  }
  .m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 56px;
    width: 100%;
    padding: 9px 0;
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: clamp(25px, 7.44vw, 31px);
    line-height: 1.2;
    color: #211d18;
    text-align: left;
    text-decoration: none;
    background: none;
    border: none;
    border-bottom: 1px dashed rgba(76, 59, 43, 0.3);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sheet-in nav > .m-link:last-child {
    border-bottom: none;
  }
  .m-link:focus-visible {
    outline: 2px solid #211d18;
    outline-offset: 2px;
  }

  /* akordeon „O nas" */
  .m-acc {
    display: flex;
    flex-direction: column;
    border-bottom: 1px dashed rgba(76, 59, 43, 0.3);
  }
  .m-acc .m-link {
    border-bottom: none;
  }
  .m-chev {
    flex: none;
    width: 14px;
    height: 9px;
    opacity: 0.5;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m-acc-btn[aria-expanded="true"] {
    color: #57654a;
  }
  .m-acc-btn[aria-expanded="true"] .m-chev {
    opacity: 1;
    transform: rotate(180deg);
  }
  .m-sub {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.36s cubic-bezier(0.32, 0.72, 0.28, 1),
      opacity 0.3s ease;
  }
  .m-acc[data-acc-open] .m-sub {
    max-height: 200px;
    opacity: 1;
  }
  .m-sub-link {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 4px 0 4px 34px;
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: 15.5px;
    color: #57654a;
    text-decoration: none;
  }
  .m-sub-link:last-child {
    padding-bottom: 14px;
  }
  .m-sub-link:hover,
  .m-sub-link:focus-visible {
    color: #414d37;
  }
  .m-sub-link:focus-visible {
    outline: 2px solid #414d37;
    outline-offset: 2px;
  }

  /* kaskadowe wjazdy pozycji (delay .06 + i·.045 s jak w designie) */
  .m-acc,
  .sheet-in nav > .m-link,
  .sheet-call {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.4s ease,
      transform 0.45s cubic-bezier(0.32, 0.72, 0.28, 1);
  }
  .sheet-ov.is-open .m-acc,
  .sheet-ov.is-open .sheet-in nav > .m-link,
  .sheet-ov.is-open .sheet-call {
    opacity: 1;
    transform: none;
  }
  .sheet-ov.is-open .sheet-in nav > *:nth-child(1) {
    transition-delay: 0.06s;
  }
  .sheet-ov.is-open .sheet-in nav > *:nth-child(2) {
    transition-delay: 0.105s;
  }
  .sheet-ov.is-open .sheet-in nav > *:nth-child(3) {
    transition-delay: 0.15s;
  }
  .sheet-ov.is-open .sheet-in nav > *:nth-child(4) {
    transition-delay: 0.195s;
  }
  .sheet-ov.is-open .sheet-call {
    transition-delay: 0.24s;
  }

  /* stopka sheeta: dwa telefony (etykieta nad numerem — design) */
  .sheet-call {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
    padding: 18px 0 0;
    border-top: 1px solid rgba(33, 29, 24, 0.14);
  }
  .sheet-call a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
    color: #211d18;
  }
  .sheet-call a[hidden] {
    display: none;
  }
  .sheet-call a b {
    font-family: var(--font-mono), monospace;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* design .45 — podbite do AA (drobny druk; ratchet axe jest pusty) */
    color: rgba(33, 29, 24, 0.64);
  }
  .sheet-call a span {
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: 23px;
    line-height: 1.2;
  }

  /* ════ DESKTOP ≥1024 (para: NAV_DESKTOP_MIN_PX w nav-config.ts) ════ */
  @media (min-width: 1024px) {
    .hdr {
      /* gutter chrome'u z designów (--g eksportów: 60→160 px) */
      padding-inline: clamp(60px, 9.72vw, 160px);
    }
    .hdr-glow {
      display: none;
    }
    /* papierowe tło stanu solid — wjeżdża opacity po zjechaniu z góry */
    .hdr-bg {
      display: block;
      position: absolute;
      inset: 0;
      /* papier + kafelek przygaszony do ~.2 (poziom tekstury z designu) */
      background:
        linear-gradient(rgba(250, 247, 241, 0.8), rgba(250, 247, 241, 0.8)),
        url("../../assets/paper-tile.webp") repeat var(--hdr-paper);
      opacity: 0;
      box-shadow: none;
      transition:
        opacity 0.3s ease,
        box-shadow 0.3s ease;
    }
    .hdr[data-solid] .hdr-bg {
      opacity: 1;
      box-shadow:
        0 1px 0 rgba(33, 29, 24, 0.09),
        0 10px 30px rgba(33, 29, 24, 0.06);
    }

    .hdr-logo {
      width: clamp(44px, 4.03vw, 64px);
    }

    .hdr-nav {
      position: relative;
      display: flex;
      align-items: center;
      gap: clamp(22px, 2.36vw, 38px);
    }

    .nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 10px 0;
      white-space: nowrap;
      background: none;
      border: none;
      border-bottom: 1px solid transparent;
      text-decoration: none;
      font-family: var(--font-mono), monospace;
      font-weight: 400;
      font-size: clamp(11px, 0.87vw, 13.5px);
      line-height: 1;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--hdr-ink);
      cursor: pointer;
      transition: color 0.2s ease;
    }
    .nav-link:hover,
    .nav-link:focus-visible {
      color: var(--hdr-accent);
    }
    .nav-link:focus-visible {
      outline: 2px solid var(--hdr-ink);
      outline-offset: 4px;
    }
    /* pozycja bieżącej strony — subtelna zieleń (adaptacja: design nie ma
       wskaźnika aktywnej strony, aria-current zostaje dla a11y) */
    .nav-link[aria-current="page"] {
      color: var(--hdr-accent);
    }

    /* dropdown „O nas" */
    .nav-about {
      position: relative;
      display: flex;
    }
    .chev {
      flex: none;
      width: 12px;
      height: 8px;
      opacity: 0.55;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hdr[data-onas] .nav-about-btn {
      color: var(--hdr-accent);
      border-bottom-color: rgba(87, 101, 74, 0.55);
    }
    .hdr[data-onas] .chev {
      opacity: 1;
      transform: rotate(180deg);
    }
    .nav-drop {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      margin-top: clamp(10px, 0.87vw, 14px);
      min-width: clamp(190px, 14.9vw, 238px);
      display: flex;
      flex-direction: column;
      padding: 6px;
      /* tekstura designu na panelu to ledwie .06 — czysty papier wystarcza */
      background: #fffdf8;
      border: 1px solid rgba(33, 29, 24, 0.12);
      box-shadow: 0 20px 48px rgba(33, 29, 24, 0.13);
    }
    .nav-drop[hidden] {
      display: none;
    }
    .drop-link {
      padding: clamp(11px, 0.97vw, 15.5px) clamp(14px, 1.25vw, 20px);
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(13px, 1.01vw, 16px);
      color: var(--hdr-ink);
      text-decoration: none;
      white-space: nowrap;
    }
    .drop-link:hover,
    .drop-link:focus-visible {
      background: rgba(87, 101, 74, 0.09);
      color: var(--hdr-accent-ink);
    }
    .drop-link:focus-visible {
      outline: 2px solid var(--hdr-accent-ink);
      outline-offset: -2px;
    }
    .drop-link[aria-current="page"] {
      color: var(--hdr-accent);
    }

    .mbtn,
    .sheet-ov {
      display: none;
    }
  }

  /* ── reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hdr,
    .hdr-bg,
    .mbtn i b,
    .sheet-ov,
    .sheet,
    .m-acc,
    .m-link,
    .m-sub,
    .m-chev,
    .chev,
    .nav-link,
    .sheet-call {
      transition: none;
    }
    .m-acc,
    .sheet-in nav > .m-link,
    .sheet-call {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import "@/scripts/overlay";
  import { fillContactSlots } from "@/lib/contact-details";
  import {
    NAV_DESKTOP_MIN_PX,
    NAV_DOWN_DELTA_PX,
    NAV_GLOW_MAX,
    NAV_GLOW_RANGE_PX,
    NAV_SOLID_FALLBACK_PX,
    NAV_SOLID_HERO_PAD_PX,
    NAV_TOP_ALWAYS_PX,
    NAV_UP_REVEAL_PX,
    NAV_ZONE_MIN_PX,
    NAV_ZONE_PANEL_PAD_PX,
    NAV_ZONE_VH,
  } from "@/components/navbar/nav-config";

  const hdr = document.querySelector<HTMLElement>("[data-nav]");
  if (hdr) {
    const burger = hdr.querySelector<HTMLButtonElement>("[data-burger]")!;
    const SHEET_ID = "nav-sheet";
    const desktopMQ = matchMedia(`(min-width:${NAV_DESKTOP_MIN_PX}px)`);

    // telefony w sheecie i stopce (antyscraping — patrz lib/contact-details)
    fillContactSlots();

    // Wysokość paska jako zmienna globalna — statyczny fallback siedzi
    // w global.css (:root), JS doprecyzowuje pomiarem (hero 4.2 wypełnia
    // pierwszy ekran: 100dvh - pasek).
    const setHdrH = () =>
      document.documentElement.style.setProperty(
        "--hdr-h",
        `${Math.round(hdr.getBoundingClientRect().height)}px`,
      );
    new ResizeObserver(setHdrH).observe(hdr);
    setHdrH();

    // ── dropdown „O nas" (desktop): toggle na klik, klik poza/Esc zamyka ──
    const dropToggle = hdr.querySelector<HTMLButtonElement>(
      "[data-dropdown-toggle]",
    )!;
    const dropPanel = hdr.querySelector<HTMLElement>("[data-dropdown-panel]")!;
    let onasOpen = false;
    function setOnas(open: boolean) {
      if (open === onasOpen) return;
      onasOpen = open;
      hdr!.toggleAttribute("data-onas", open);
      dropToggle.setAttribute("aria-expanded", String(open));
      dropPanel.hidden = !open;
    }
    dropToggle.addEventListener("click", () => setOnas(!onasOpen));
    document.addEventListener("click", (e) => {
      if (onasOpen && !(e.target as HTMLElement).closest("[data-dropdown]"))
        setOnas(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && onasOpen) setOnas(false);
    });

    // ── auto-hide paska (E11, desktop-only) — algorytm z eksportów
    // (docs/analiza-chrome.md §1): chowanie przy scrollu w dół, powrót po
    // >60 px w górę LUB gdy kursor w górnej strefie; przy otwartym
    // dropdownie strefa sięga pod panel (+48 px), a schowanie paska
    // ZAMYKA dropdown (panel nigdy nie zostaje bez paska). ──
    let lastY = window.scrollY;
    let upAcc = 0;
    let cursorTop = false;
    let hidden = false;
    function setHidden(h: boolean) {
      if (h === hidden) return;
      hidden = h;
      hdr!.toggleAttribute("data-hidden", h);
      if (h) setOnas(false);
    }
    function setSolid(s: boolean) {
      hdr!.toggleAttribute("data-solid", s);
    }
    // Próg stanu solid: wysokość hero ([data-navref], wchodzi w 4.2) minus
    // zapas; bez hero — zaraz po ruszeniu scrolla (przezroczysty pasek nad
    // treścią = kolizja typografii).
    const navref = document.querySelector<HTMLElement>("[data-navref]");
    const solidAt = () =>
      navref
        ? navref.offsetHeight - NAV_SOLID_HERO_PAD_PX
        : NAV_SOLID_FALLBACK_PX;

    function zoneLimit() {
      let limit = Math.max(NAV_ZONE_MIN_PX, innerHeight * NAV_ZONE_VH);
      if (onasOpen) {
        limit = Math.max(
          limit,
          dropPanel.getBoundingClientRect().bottom + NAV_ZONE_PANEL_PAD_PX,
        );
      }
      return limit;
    }
    function onMove(e: MouseEvent) {
      if (!desktopMQ.matches) return;
      const top = e.clientY < zoneLimit();
      if (top === cursorTop) return;
      cursorTop = top;
      if (top) setHidden(false);
      else if (lastY > NAV_TOP_ALWAYS_PX && upAcc <= NAV_UP_REVEAL_PX)
        setHidden(true);
    }
    function onLeave() {
      if (!desktopMQ.matches || onasOpen) return;
      cursorTop = false;
      if (lastY > NAV_TOP_ALWAYS_PX && upAcc <= NAV_UP_REVEAL_PX)
        setHidden(true);
    }

    // ── glow mobile: dekoracja zależna od scrolla wygładzana WŁASNĄ pętlą
    // rAF (scroll.md/D-Q1 — Safari dostarcza `scroll` rzadziej, niż
    // przewija); scroll strony zostaje natywny. ──
    const glow = hdr.querySelector<HTMLElement>(".hdr-glow")!;
    const glowTarget = () =>
      Math.min(1, window.scrollY / NAV_GLOW_RANGE_PX) * NAV_GLOW_MAX;
    let glowCur: number | null = null;
    let glowRaf = 0;
    const paintGlow = () => {
      glowRaf = 0;
      const t = glowTarget();
      glowCur = glowCur === null ? t : glowCur + (t - glowCur) * 0.18;
      if (Math.abs(t - glowCur) < 0.002) glowCur = t;
      glow.style.opacity = glowCur.toFixed(3);
      if (glowCur !== t) glowRaf = requestAnimationFrame(paintGlow);
    };
    const scheduleGlow = () => {
      if (!glowRaf) glowRaf = requestAnimationFrame(paintGlow);
    };

    function onScroll() {
      const y = window.scrollY;
      const d = y - lastY;
      lastY = y;
      setSolid(y > solidAt());
      if (!desktopMQ.matches) {
        scheduleGlow();
        return;
      }
      if (y <= NAV_TOP_ALWAYS_PX) {
        upAcc = 0;
        setHidden(false);
        return;
      }
      if (d > NAV_DOWN_DELTA_PX) {
        upAcc = 0;
        if (!cursorTop) setHidden(true);
        return;
      }
      if (d < 0) {
        upAcc -= d;
        if (upAcc > NAV_UP_REVEAL_PX || cursorTop) setHidden(false);
      }
    }
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("mousemove", onMove, { passive: true });
    document.documentElement.addEventListener("mouseleave", onLeave);
    onScroll();
    if (!desktopMQ.matches) paintGlow();

    // ── menu mobilne: bottom sheet przez overlay.ts ──
    let isOpen = false;
    function setMenuState(open: boolean) {
      isOpen = open;
      hdr!.toggleAttribute("data-open", open);
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute(
        "aria-label",
        (open ? burger.dataset.closeLabel : burger.dataset.openLabel) || "",
      );
    }
    burger.addEventListener("click", () => {
      if (isOpen) {
        window.overlay?.close(SHEET_ID);
      } else {
        setMenuState(true);
        // onClose łapie KAŻDĄ drogę zamknięcia (Esc, scrim, swipe, link)
        window.overlay?.open(SHEET_ID, {
          onClose: () => setMenuState(false),
        });
      }
    });

    // ── akordeon „O nas" w sheecie ──
    const acc = document.querySelector<HTMLElement>("#nav-sheet .m-acc");
    const accBtn = acc?.querySelector<HTMLButtonElement>("[data-acc-toggle]");
    function setAcc(open: boolean) {
      acc?.toggleAttribute("data-acc-open", open);
      accBtn?.setAttribute("aria-expanded", String(open));
    }
    accBtn?.addEventListener("click", () =>
      setAcc(!acc!.hasAttribute("data-acc-open")),
    );

    // zmiana progu: domknij sheet (spójny stan nakładek), zwiń akordeon,
    // zamknij dropdown i odkryj pasek — czysty stan po obu stronach progu
    desktopMQ.addEventListener("change", (e) => {
      if (e.matches && isOpen) window.overlay?.close(SHEET_ID);
      setAcc(false);
      setOnas(false);
      upAcc = 0;
      cursorTop = false;
      setHidden(false);
      onScroll();
    });
  }
</script>
