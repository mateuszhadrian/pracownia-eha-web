---
// Stopka `ft` — STAN SZKIELETU Etapu 0: mechanika odziedziczona z szablonu
// z brandingiem EH/A. Docelowa stopka eha (2 kolumny linków O NAS/OFERTA,
// „NA GÓRĘ ↑") wchodzi w Etapie 4.1 wg docs/design/index.html. Ciemna,
// full-bleed — strony renderują ją bez własnych wrapperów z paddingiem.
// Tel/mail składane w JS (antyscraping — sloty lib/contact-details,
// DWA telefony MACIEK/ŁUKASZ). Kolory lokalne, niezależne od tokenów
// strony (stopka jest ciemna niezależnie od motywu widoku).
import { footerNavItems } from "@/i18n/nav";
import { CONTACT_PATH, HOME_PATH, POLICY_PATH } from "@/lib/routes";
import logo from "@/assets/logo/eha-logo.svg";
---

<footer class="ft">
  <div class="wrap ft-in">
    <div>
      <a class="ft-logo" href={HOME_PATH}>
        <img
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt="Pracownia EH/A"
        />
      </a>
      <p class="ft-desc">
        Remonty domów z historią — ciesielstwo, murarstwo, sklepienia, fizyka
        budowli i instalacje.
      </p>
    </div>
    <nav class="ft-nav" aria-label="Stopka — strony">
      <span class="ft-h dOnly">Strony</span>
      {
        footerNavItems.map((item) => (
          <a href={item.href} class:list={[item.href === POLICY_PATH && "dim"]}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ft-call">
      <span class="ft-h">Zadzwoń do nas</span>
      {
        /* numery/adres i href składane w JS (antyscraping); placeholder
           href = poprawny link także bez JS (i tak hidden do czasu
           złożenia); etykiety imion zostają w SSR */
      }
      <a class="ft-tel" data-tel="maciek" href={CONTACT_PATH} hidden>
        <b>Maciek</b>
        <span data-slot>Telefon</span>
      </a>
      <a class="ft-tel" data-tel="lukasz" href={CONTACT_PATH} hidden>
        <b>Łukasz</b>
        <span data-slot>Telefon</span>
      </a>
      <a class="ft-mail" data-mail href={CONTACT_PATH} hidden>E-mail</a>
      <div class="ft-soc">
        <a
          href="https://www.instagram.com/pracowniaeha/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect
              x="2"
              y="2"
              width="20"
              height="20"
              rx="5"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <circle
              cx="12"
              cy="12"
              r="4"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
          </svg>
          Instagram
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61574396106209"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M15 8h2.5V4.5H15c-2.5 0-4 1.5-4 4V11H8.5v3.5H11v5h3.5v-5h2.6l.4-3.5h-3V8.8c0-.5.3-.8 1-.8z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
          </svg>
          Facebook
        </a>
      </div>
    </div>
  </div>
  <div class="wrap ft-bot">
    <p>© 2026 PRACOWNIA EH/A. Wszystkie prawa zastrzeżone.</p>
    <p class="ft-legal">
      Pracownia Łukasz Jarosz-Jarszewski · Strzyżowiec 30, 59-610 Wleń · NIP
      527-244-99-69 · REGON 540526327
    </p>
    <p class="ft-cred">
      Realizacja: <a href="https://hadrianm.pl" target="_blank" rel="noopener"
        >hadrianm</a
      > — pracownia stron i aplikacji
    </p>
  </div>
</footer>

<style>
  .ft {
    /* kolory stopki NIEZALEŻNE od tokenów strony (D-CH9) */
    --ft-bg: #161616;
    /* alphy drobnych tekstów podbite względem eksportu (.28–.45 → AA) */
    --ft-dim: rgba(255, 255, 255, 0.64);
    --ft-soft: rgba(255, 255, 255, 0.75);
    --ft-hair: rgba(255, 255, 255, 0.14);
    background: var(--ft-bg);
    color: #fff;
    padding-top: 46px;
    padding-bottom: 26px;
  }
  .ft a {
    color: inherit;
    text-decoration: none;
  }
  .ft a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .wrap {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .ft-in {
    display: flex;
    flex-direction: column;
  }
  .ft-logo {
    display: block;
    /* logo EH/A ~kwadratowe — mniejsza szerokość niż poziome logo szablonu */
    width: clamp(96px, 28vw, 120px);
  }
  .ft-logo:hover {
    opacity: 0.7;
  }
  .ft-logo img {
    display: block;
    width: 100%;
    height: auto;
    /* SVG rysuje atramentem (currentColor→czarny w <img>); stopka jest
       ciemna — odwracamy do bieli. Docelowy wariant koloru: Etap 4.1. */
    filter: invert(1);
  }
  .ft-desc {
    display: none;
  }

  .ft-nav {
    display: flex;
    flex-direction: column;
    margin-top: 28px;
    border-top: 1px solid var(--ft-hair);
  }
  .ft-nav a {
    padding: 15px 0;
    border-bottom: 1px solid var(--ft-hair);
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1;
  }
  .ft-nav a:hover {
    opacity: 0.6;
  }

  .ft-h {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ft-dim);
  }
  .ft-call {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 28px;
  }
  .ft-tel {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    font-size: clamp(19px, 5.38vw, 24px);
    line-height: 1.2;
  }
  .ft-tel b {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ft-dim);
  }
  .ft-tel[hidden],
  .ft-mail[hidden] {
    display: none;
  }
  .ft-tel:hover,
  .ft-mail:hover {
    opacity: 0.6;
  }
  .ft-mail {
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--ft-soft);
    overflow-wrap: anywhere;
  }
  .ft-soc {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .ft-soc a {
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 10px 17px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: 13.5px;
    white-space: nowrap;
  }
  .ft-soc a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .ft-soc svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .ft-bot {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--ft-hair);
  }
  .ft-bot p {
    margin: 0;
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    color: var(--ft-dim);
  }
  .ft-bot p:first-child {
    font-size: 11.5px;
    line-height: 1.7;
  }
  .ft-legal {
    font-size: 11px;
    line-height: 1.7;
  }
  .ft-cred {
    font-size: 10.5px;
    line-height: 1.7;
  }
  .ft-bot a {
    color: var(--ft-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ft-bot a:hover {
    color: #fff;
  }

  /* ════ DESKTOP ≥1024 (para: NAV_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .ft {
      padding-top: clamp(52px, 4.86vw, 70px);
      padding-bottom: 30px;
    }
    .ft-in {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: clamp(34px, 4.17vw, 60px);
      padding-bottom: clamp(38px, 3.61vw, 52px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .ft-logo {
      width: clamp(96px, 8.4vw, 120px);
    }
    .ft-desc {
      display: block;
      margin: 24px 0 0;
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(13px, 1.01vw, 14.5px);
      line-height: 1.7;
      color: var(--ft-dim);
      max-width: 38ch;
    }
    .ft-nav {
      margin-top: 0;
      border: none;
      gap: 14px;
    }
    .ft-nav a {
      padding: 0;
      border: none;
      font-size: clamp(14px, 1.04vw, 15px);
    }
    .ft-nav a.dim {
      color: var(--ft-dim);
    }
    .ft-h {
      letter-spacing: 0.2em;
    }
    .ft-call {
      margin-top: 0;
      gap: 10px;
    }
    .ft-tel {
      font-size: clamp(21px, 1.81vw, 26px);
    }
    .ft-mail {
      font-size: clamp(14px, 1.04vw, 15px);
      line-height: 1.5;
    }
    .ft-soc {
      margin-top: 16px;
    }
    .ft-bot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 0;
      padding-top: 22px;
      border: none;
    }
  }

  /* mobile: nagłówek „Strony" tylko desktop (jak dOnly z eksportu) */
  @media (max-width: 1023.98px) {
    .dOnly {
      display: none;
    }
  }
</style>

<script>
  import { fillContactSlots } from "@/lib/contact-details";

  // Telefon/mail stopki (antyscraping — D-CH5). Idempotentne względem
  // wypełnienia z Navbara (te same wartości do tych samych slotów).
  fillContactSlots();
</script>
