---
// Tło widoku wg eksportów (korekta Mateusza z 4.2, od 4.3 wspólne dla
// `/` i `/realizacje/` — oba eksporty mają identyczny wzorzec): duży
// skan papieru (paper-background) na kremowej bazie — mobile
// `center/cover`, scrolluje się z treścią 1:1; desktop `top center /
// 100% auto repeat-y` z DRYFEM: eksport przesuwał background-position
// o 0.15·scroll na elemencie jadącym z treścią, więc tekstura płynie
// w 0.85 tempa treści (PAPER_BG_SPEED). Port dryfu: element FIXED
// przesuwany TRANSFORMEM zawiniętym modulo okres tekstury (sam
// kompozytor, zero przemalowań — lekcja D-Q1; eksportowe ruszanie
// background-position przemalowywałoby warstwę co klatkę). Ruch liczy
// pętla modułu ruchu widoku (home-motion.ts / work-motion.ts) za bramką
// js-motion; bez JS / przy reduce tekstura desktop zostaje absolute
// i scrolluje z treścią (strona kompletna bez dryfu).
//
// Konsument daje kontenerowi: position:relative + isolation:isolate
// (z-index -1 tekstury zostaje pod treścią) + background var(--bg-cream);
// kafelek body zostaje pod chrome'em pozostałych tras.
import paper from "@/assets/paper-background.webp";

// okres pionowy tekstury przy szerokości 100vw (repeat-y)
const ratio = paper.height / paper.width;
---

<div class="pbk" aria-hidden="true">
  <div
    class="pbk-tex"
    data-paper-tex
    data-ratio={String(ratio)}
    style={`--pbk-url:url('${paper.src}');--pbk-ratio:${ratio}`}
  >
  </div>
</div>

<style>
  .pbk {
    position: absolute;
    inset: 0;
    /* pod treścią main (stacking context: isolation na kontenerze) */
    z-index: -1;
    pointer-events: none;
  }
  .pbk-tex {
    position: absolute;
    inset: 0;
    background: var(--pbk-url) center / cover no-repeat;
    /* poziom tekstury z eksportu */
    opacity: 0.2;
  }

  /* ════ DESKTOP ≥1024 (breakpoint projektu) ════ */
  @media (min-width: 1024px) {
    .pbk-tex {
      background: var(--pbk-url) top center / 100% auto repeat-y;
    }
    /* dryf tylko pod js-motion: fixed + zapas jednego okresu na dole —
       transform przesuwa w zakresie [−okres, 0], krawędź nigdy nie
       wjeżdża w viewport */
    :global(html.js-motion) .pbk-tex {
      position: fixed;
      inset: auto;
      left: 0;
      right: 0;
      top: 0;
      height: calc(100vh + 100vw * var(--pbk-ratio));
      will-change: transform;
    }
  }
</style>
