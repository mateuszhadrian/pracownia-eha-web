---
// Treść detalu realizacji (Etap 4.3) — skin wg eksportu
// docs/design/export/realizacje.html (analiza-realizacje §1–2), markup
// `dt-*` wspólny dla obu progów JEDNEGO overlaya #work-detail
// (WorkDetailOverlay.astro): <1024 bottom sheet (galeria-karuzela
// w strumieniu scrolla), ≥1024 modal (galeria przenoszona przez
// open-detail.ts do lewej kolumny panelu — wzorzec placeGal eksportu).
// Renderowana wewnątrz <template data-work-detail={slug}> i klonowana
// do hosta przy otwarciu; liczniki (REALIZACJA NN/NN, 01/0N) maluje
// open-detail.ts po klonowaniu.
//
// Wideo (E8): preload="none", a miniaturą jest klatka wycięta z samego
// filmu (videoFrameAt, środek liczony z `duration`) — pozycja z filmem
// NIE MA własnego zdjęcia. Klatka JEDNĄ drogą: <img class="dt-poster">
// pod <video>, BEZ atrybutu `poster` (korekta po produkcji 4.3 —
// szczegóły przy mapowaniu galerii niżej; wcześniejsze „dwie drogi"
// delung i tak nie działały w Chromium, które przy preload="none" nie
// pobiera plakatu NIGDY — pomiar szablonu). Odtwarzanie na tap bez
// zmian; `duration` służy też za badge czasu (desktop).
import rycHouse from "@/assets/dom-ryc-house1.webp";
import { imgAt, videoFrameAt } from "@/lib/img";
import { workDetailPath } from "@/lib/routes";
import { WORK_GALLERY_DASHES_MAX } from "./work-config";
import type { ViewProject } from "./work-data";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props as unknown as Props;
const p = project;
const pad = (n: number) => String(n).padStart(2, "0");
// Kreski-wskaźniki tylko przy krótkiej galerii (korekta Mateusza) —
// powyżej progu rząd przestaje się mieścić, zostaje sam licznik.
const showDashes = p.gallery.length <= WORK_GALLERY_DASHES_MAX;
// Parametry są opcjonalne w CMS — bez nich blok PARAMETRY nie istnieje.
const hasSpecs = p.specs.length > 0;
// „Inne realizacje z inwestycji" (docs/analiza-inne-realizacje.md) —
// opcjonalne jak parametry; lista ROZWIĄZANA w work-list.ts (martwe
// odwołania, duplikaty i wskazanie samej siebie już odfiltrowane).
const hasRelated = p.related.length > 0;
// Dolny odstęp przed stopką ma OSTATNI blok treści (sekcja powiązań jest
// zawsze ostatnia, więc swój odstęp ma wbudowany).
const last = hasRelated ? "related" : hasSpecs ? "specs" : "about";
const relHeadId = `dt-rel-h-${p.slug}`;
---

<div class="dt-head">
  <span data-projcount>REALIZACJA 01 / 01</span>
  <button class="dt-x" type="button" data-overlay-close aria-label="Zamknij">
    <i aria-hidden="true"><b></b><b></b></i>
  </button>
</div>

<div class="dt-txt">
  {
    /* rycina za prawą krawędzią kolumny treści (eksport: opacity
      .12–.13, multiply) — wersja Z ALFĄ (lekcja 4.2 §2a: blend potrafi
      zgasnąć przy body{position:fixed}, alfa degraduje się niewidocznie) */
  }
  <img
    class="dt-ryc"
    src={rycHouse.src}
    width={rycHouse.width}
    height={rycHouse.height}
    alt=""
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <div class="dt-meta">
    <span class="dt-place">{p.place}</span>
    <span class="dt-meta-dash" aria-hidden="true"></span>
    <span class="dt-year">{p.year}</span>
  </div>
  <h2 class="dt-title">{p.title}</h2>
</div>

<div class="dt-gal" data-gal>
  {
    /* tabindex + nazwa: na mobile tor jest PRZEWIJALNY w bok, więc musi
      być osiągalny klawiaturą (axe `scrollable-region-focusable`, serious
      — wyszło przy skanie podstrony realizacji, pierwszym skanie otwartego
      detalu; sesja linków). Na desktopie tor nie scrolluje (translateX),
      kadry przełącza klawiatura ←/→ — tab-stop jest tam nieszkodliwy. */
  }
  {
    /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex --
      przewijalny region MUSI być osiągalny klawiaturą (WCAG 2.1.1, axe
      scrollable-region-focusable) — wymóg wygrywa z heurystyką lintera */
  }
  <div
    class="dt-track"
    data-track
    tabindex="0"
    role="group"
    aria-label={`Galeria realizacji: ${p.title}`}
  >
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    {
      p.gallery.map((item, i) => {
        // Klatka-miniatura filmu — WYŁĄCZNIE jako <img class="dt-poster">
        // pod <video>, BEZ atrybutu `poster` (korekta Mateusza po
        // produkcji 4.3): silniki malują obraz z atrybutu ROZCIĄGNIĘTY
        // do pudełka elementu, ignorując object-fit (WebKit), przez co
        // nad poprawnym <img> lądowała zdeformowana klatka — w galerii
        // i jako tło grającego filmu w podglądzie. Atrybut i tak nie był
        // pewną drogą (Chromium przy preload="none" nie pobiera go
        // NIGDY — pomiar szablonu), więc <img> zostaje jedynym źródłem:
        // cover w galerii (wycięty środek wypełnia kadr), contain
        // w podglądzie (czerń wokół — jak sam film).
        const klatka =
          item.type === "video"
            ? videoFrameAt(item.video, item.duration)
            : undefined;
        return (
          <div class="dt-slide" data-slide>
            {item.type === "video" ? (
              <>
                {/* Galeria żyje w <template>, więc obraz nie jest pobierany
                  do czasu otwarcia detalu — zero kosztu dla LCP listy. */}
                {klatka && (
                  <img
                    class="dt-poster"
                    src={klatka}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    style={
                      item.position
                        ? `object-position: ${item.position}`
                        : undefined
                    }
                  />
                )}
                {/* Bez `controls` i bez własnego znaku play (E8):
                  tap/klik w kadr odpala film w podglądzie
                  pełnoekranowym; stan sygnalizuje ikonka kamery. */}
                {/* eslint-disable-next-line astro/jsx-a11y/media-has-caption --
                  klipy realizacji to nieme b-rolle z placu budowy */}
                <video
                  src={item.video}
                  preload="none"
                  playsinline
                  style={
                    item.position
                      ? `object-position: ${item.position}`
                      : undefined
                  }
                />
                {/* Badge „…, aby obejrzeć" w prawym górnym rogu kadru
                  (design eha: tekst na ciemnej plakietce). Dwa warianty
                  treści w SSR zamiast podmiany w JS — przełącza @media
                  w parze z WORK_DESKTOP_MIN_PX. aria-hidden — to
                  dekoracja dla wzroku, nie druga nazwa kadru. Znika
                  i wraca RAZEM z ikonką kamery (reguła .is-playing
                  w WorkDetailOverlay.astro). */}
                <span class="dt-hint" data-cam-hint aria-hidden="true">
                  <span class="dt-hint-d">Kliknij, aby obejrzeć</span>
                  <span class="dt-hint-m">Stuknij, aby obejrzeć</span>
                  {/* Trzeci wariant tej samej plakietki: WSKAŹNIK
                      ŁADOWANIA (sesja poprawek wizualnych). Pokazuje go
                      klasa `.is-loading` na slajdzie podglądu — reguły
                      w WorkDetailOverlay.astro, stan pilnuje
                      open-detail.ts. Powód: hint znikał przy zdarzeniu
                      `play` (65 ms), a obraz ruszał dopiero na `playing`
                      — zmierzone 0,65 s bez throttlingu, 2,0 s na Fast
                      3G i 7,5 s na Slow 3G. Przez ten czas użytkownik
                      widział nieruchomy kadr bez żadnego znaku i brał go
                      za zdjęcie. Kropki są osobnymi elementami, bo
                      animuje je CSS (delayem), nie JS. */}
                  {/* Kropki rysuje `content: "."` z ::before, a nie tekst
                      w DOM: między sąsiednimi <b> prettier wstawia białe
                      znaki, które przeglądarka renderuje jako spacje —
                      wyszłoby „. . ." zamiast „...". Są dekoracją
                      (aria-hidden), więc pseudoelement jest tu na miejscu;
                      testy liczą <b>, a tekstu szukają bez kropek. */}
                  <span class="dt-hint-load">
                    Poczekaj, ładuję wideo
                    <i class="dt-dots" aria-hidden="true">
                      <b />
                      <b />
                      <b />
                    </i>
                  </span>
                </span>
                <span class="dt-cam" data-cam aria-hidden="true">
                  <svg viewBox="0 0 21 14" fill="none">
                    <rect
                      x="0.5"
                      y="2"
                      width="12.5"
                      height="10"
                      rx="2.2"
                      fill="currentColor"
                    />
                    <path d="M14.4 6.2l6-3.4v8.4l-6-3.4z" fill="currentColor" />
                  </svg>
                </span>
                {item.duration && <span class="dt-time">{item.duration}</span>}
              </>
            ) : (
              <img
                src={imgAt(item.image, "full")}
                alt={`${p.title} — zdjęcie ${i + 1}`}
                loading="lazy"
                decoding="async"
                draggable="false"
                style={
                  item.position
                    ? `object-position: ${item.position}`
                    : undefined
                }
              />
            )}
          </div>
        );
      })
    }
  </div>
  <div class="dt-galbar">
    <span class="dt-shotnav">
      <button type="button" data-prevshot aria-label="Poprzednie zdjęcie">
        <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path
            d="M9.5 1L1.5 9l8 8"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="button" data-nextshot aria-label="Następne zdjęcie">
        <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path
            d="M1.5 1l8 8-8 8"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </span>
    <span class="dt-galside">
      {
        showDashes && (
          <span class="dt-dashes" data-dashes>
            {p.gallery.map((_, i) => (
              <button
                type="button"
                data-shot={i}
                class={i === 0 ? "on" : undefined}
                aria-label={`Zdjęcie ${i + 1}`}
              />
            ))}
          </span>
        )
      }
      <span class="dt-count" data-shotcount>01 / {pad(p.gallery.length)}</span>
    </span>
  </div>
</div>

{
  /* Parametry i powiązania są opcjonalne (CMS): przy pustej liście blok
    nie istnieje w ogóle, a dolny odstęp przed stopką przejmuje ostatni
    blok, który jest (`--last`). Bez powiązań render jest identyczny jak
    przed ich wprowadzeniem. */
}
<div class:list={["dt-about", { "dt-about--last": last === "about" }]}>
  {p.paras.map((t) => <p class="dt-desc">{t}</p>)}
</div>

{
  hasSpecs && (
    <div class:list={["dt-specs", { "dt-specs--last": last === "specs" }]}>
      <div class="dt-specs-h">
        <span>PARAMETRY</span>
        <i aria-hidden="true" />
      </div>
      <div class="dt-spec-list">
        {p.specs.map((s) => (
          <div class="dt-spec">
            <b>{s.label}</b>
            <i aria-hidden="true" />
            <span>{s.value}</span>
          </div>
        ))}
      </div>
    </div>
  )
}

{
  /* „Inne realizacje z inwestycji" — na samym dole treści (pod
    parametrami, bez nich pod opisem). ZWYKŁE linki pod stały adres
    realizacji: przeglądarka ładuje podstronę z detalem otwartym od wejścia
    („jakby wpisać adres"). Celowo BEZ `data-work-slug` — ten atrybut
    przechwytują kafle (otwarcie detalu w miejscu). open-detail.ts
    i overlay.ts tych kliknięć nie dotykają. Nagłówek = klasa nagłówka
    PARAMETRY (ten sam wygląd bez kopii reguł). */
}
{
  hasRelated && (
    <nav class="dt-rel" aria-labelledby={relHeadId}>
      <div class="dt-specs-h">
        <span id={relHeadId}>INNE REALIZACJE Z INWESTYCJI</span>
        <i aria-hidden="true" />
      </div>
      <ul class="dt-rel-list">
        {p.related.map((r) => (
          <li>
            <a class="dt-rel-a" href={workDetailPath(r.slug)}>
              <span class="dt-rel-meta">
                {r.place} · {r.year}
              </span>
              <span class="dt-rel-t">{r.title}</span>
              <span class="dt-rel-arr" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  /* Stopka detalu = UDOSTĘPNIJ (decyzja Mateusza, sesja linków — zastąpiła
    „CHCESZ WIĘCEJ INFORMACJI?" + „Skontaktuj się z nami"; ten sam styl
    przycisku, ikona udostępniania zamiast strzałki). Telefon: systemowe
    menu udostępniania (WhatsApp, SMS, Messenger…), desktop: kopiowanie
    linku do schowka — logika w open-detail.ts. Link = stały adres
    podstrony tej realizacji. Oba teksty stanu siedzą w SSR, JS zapala
    tylko klasę `.is-copied` (wzorzec komunikatów formularza kontaktu). */
}
<div class="dt-foot">
  <button
    class="dt-ask"
    type="button"
    data-share
    data-share-path={workDetailPath(p.slug)}
    data-share-title={p.title}
  >
    <span class="dt-share-txt">
      <span class="dt-share-l">Udostępnij realizację</span>
      <span class="dt-share-ok" aria-hidden="true">Link skopiowany</span>
    </span>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="12.4" cy="3.4" r="2.1" fill="none" stroke="currentColor"
      ></circle>
      <circle cx="3.6" cy="8" r="2.1" fill="none" stroke="currentColor"
      ></circle>
      <circle cx="12.4" cy="12.6" r="2.1" fill="none" stroke="currentColor"
      ></circle>
      <path
        d="M5.5 7l5-2.6M5.5 9l5 2.6"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <span class="sr-only" role="status" data-share-status></span>
</div>

<style>
  /* ── Mobile (<1024): jeden strumień scrolla w dt-body (sheet) ── */
  .dt-head {
    display: none;
  }

  /* dt-body (sheet) to flex column ze scrollem — bloki treści muszą być
     nieściśliwe (flex: none), inaczej overflow:hidden zeruje ich
     automatyczny minimalny rozmiar i flex zgniata je do paddingu */
  .dt-txt,
  .dt-gal,
  .dt-about,
  .dt-specs,
  .dt-rel,
  .dt-foot {
    flex: none;
  }
  .dt-txt {
    position: relative;
    overflow: hidden;
    padding: 4px 24px 0;
  }
  .dt-ryc {
    position: absolute;
    right: -40px;
    top: -14px;
    width: 150px;
    max-width: none;
    height: auto;
    opacity: 0.13;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .dt-meta {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 9px;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(87, 101, 74, 0.95);
  }
  .dt-place {
    text-transform: uppercase;
  }
  .dt-meta-dash {
    flex: none;
    width: 14px;
    height: 1px;
    background: rgba(87, 101, 74, 0.5);
  }
  .dt-title {
    position: relative;
    margin: 0;
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: clamp(26px, 7.4vw, 29px);
    line-height: 1.14;
    color: var(--ink);
    text-wrap: pretty;
    padding-right: 34px;
  }

  /* ── Galeria: karuzela snap 4:3 (eksport: 300 px + gap 10) ── */
  .dt-gal {
    margin-top: 18px;
    position: relative;
  }
  .dt-track {
    display: flex;
    /* gap zaszyty też w JS: open-detail liczy `offsetWidth + 10` —
       zmiana gapu wymaga zmiany PARY (twarde założenie portu) */
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 24px;
    padding-inline: 24px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .dt-track::-webkit-scrollbar {
    display: none;
  }
  .dt-slide {
    flex: 0 0 300px;
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background: var(--bg-dark);
    scroll-snap-align: start;
    /* kafel po kaflu — gotcha karuzel (sections.md) */
    scroll-snap-stop: always;
    /* tap/klik w kadr otwiera podgląd pełnoekranowy */
    cursor: zoom-in;
  }
  .dt-slide img,
  .dt-slide video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.16) saturate(0.88);
  }
  /* ikonka kamery (lewy górny róg kadru wideo) — znika, gdy film gra
     (klasa is-playing na slajdzie podglądu; w galerii film nie gra) */
  .dt-cam {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(12, 10, 8, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .dt-cam svg {
    width: 21px;
    height: 14px;
  }
  /* badge „Stuknij/Kliknij, aby obejrzeć" — prawy górny róg kadru,
     ciemna plakietka (design eha). Nie łapie zdarzeń — tap w kadr
     ma otwierać podgląd, tak jak przy ikonce kamery. */
  .dt-hint {
    position: absolute;
    top: 14px;
    right: 10px;
    max-width: calc(100% - 68px);
    padding: 5px 9px;
    background: rgba(12, 10, 8, 0.55);
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-align: right;
    color: #f5efe3;
    pointer-events: none;
  }
  .dt-hint-d {
    display: none;
  }
  /* Wariant „ładuję" siedzi w SSR obok dwóch pozostałych i domyślnie
     jest schowany — odsłania go klasa `.is-loading` na slajdzie podglądu
     (reguły + animacja kropek: blok is:global w WorkDetailOverlay.astro,
     bo klasę nadaje open-detail.ts na sklonowanym węźle). */
  .dt-hint-load {
    display: none;
  }
  /* Kropki „…" jako trzy elementy — animuje je CSS delayem, nie JS.
     Bez ruchu (reduce / brak animacji) muszą być WIDOCZNE, więc stan
     spoczynku to opacity 1, a animacja dopiero go zbija. */
  .dt-dots {
    font-style: normal;
  }
  .dt-dots b {
    font-weight: inherit;
  }
  .dt-dots b::before {
    content: ".";
  }
  .dt-time {
    display: none;
  }

  /* pasek pod karuzelą: kreski-wskaźniki po lewej + licznik po prawej */
  .dt-galbar {
    display: flex;
    align-items: center;
    padding: 11px 24px 0;
  }
  .dt-shotnav {
    display: none;
  }
  .dt-galside {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .dt-dashes {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .dt-dashes button {
    appearance: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 8px;
    height: 2px;
    background: rgba(33, 29, 24, 0.2);
    transition:
      width 0.2s ease,
      background 0.2s ease;
  }
  .dt-dashes button.on {
    width: 16px;
    background: var(--accent);
  }
  .dt-count {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--faint);
    /* licznik trzyma prawą krawędź także BEZ kresek (galeria > próg —
       wskaźniki nie są wtedy renderowane) */
    margin-left: auto;
  }

  /* ── Akapity ── */
  .dt-about {
    padding: 22px 24px 0;
  }
  /* Ostatni blok treści: ten sam odstęp do stopki, który dawał .dt-specs */
  .dt-about--last {
    padding-bottom: 34px;
  }
  .dt-desc {
    margin: 0;
    font-family: var(--font-body), sans-serif;
    font-size: clamp(14px, 3.85vw, 14.5px);
    line-height: 1.75;
    color: var(--faint);
    text-wrap: pretty;
  }
  .dt-desc + .dt-desc {
    margin-top: 13px;
  }

  /* ── PARAMETRY: wiersze z kropkowanym wypełniaczem (design) ── */
  .dt-specs {
    margin-top: 26px;
    padding: 0 24px;
  }
  .dt-specs--last {
    padding-bottom: 34px;
  }
  .dt-specs-h {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.2em;
    color: rgba(87, 101, 74, 0.95);
  }
  .dt-specs-h i {
    flex: 1;
    height: 1px;
