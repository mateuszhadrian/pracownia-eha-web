---
// JEDEN overlay detalu realizacji (Etap 4.3) — skin wg eksportu
// docs/design/export/realizacje.html (analiza-realizacje §1–2):
// <1024 bottom sheet 90 % na papierze (grabber, X, swipe-down
// z overlay.ts), ≥1024 modal min(1260px, max(720px, 100vw−180px))
// × 86 vh wyśrodkowany (57 % kadr / 43 % treść). Wybór wariantu to
// czysty CSS przy WORK_DESKTOP_MIN_PX; zmiana progu przy otwartym
// detalu ZAMYKA go (open-detail.ts, reguła sections.md).
//
// Treść klonuje open-detail.ts z <template data-work-detail={slug}>
// do hosta [data-work-host]; projnav (strzałki poprzednia/następna
// realizacja, desktop) to chrome — siedzi POZA panelem (fixed
// w rodzicu .dt-ov; wewnątrz panelu psułby go transform modala),
// open-detail.ts stopuje propagację kliknięć, żeby delegacja
// overlay.ts nie wzięła ich za klik w tło. Kolejność `.dt` przed
// `.lb` w DOM = twarde założenie portu.
//
// Podgląd pełnoekranowy (E7): kadr = CAŁE zdjęcie/wideo
// `object-fit: contain` na czarnym pełnym ekranie (bez ramy 330/412
// delung); licznik mobilny na stałym dolnym pasie. Klawiatura ←/→
// w podglądzie i w galerii detalu — open-detail.ts.
// Konsument: realizacje.astro (strona główna linkuje płasko — E5).
---

<div
  class="dt-ov"
  id="work-detail"
  data-overlay
  data-overlay-kind="sheet"
  role="dialog"
  aria-modal="true"
  hidden
>
  <div class="dt" data-overlay-panel tabindex="-1">
    <div class="dt-grab" data-overlay-drag>
      <span aria-hidden="true"></span>
    </div>
    {
      /* X sheeta (mobile) — kwadrat na papierze (design); desktop
        zamyka X w dt-head klonowanym z treścią. */
    }
    <button class="dt-xm" type="button" data-overlay-close aria-label="Zamknij">
      <i aria-hidden="true"><b></b><b></b></i>
    </button>
    <div class="dt-body" data-overlay-scroll data-work-host></div>
  </div>

  {
    /* ── Podgląd pełnoekranowy galerii: tap/klik w kadr otwiera pełny
      ekran; slajdy wypełnia open-detail.ts klonami kadrów bieżącego
      projektu. data-overlay-panel TAKŻE tutaj — dla delegacji
      overlay.ts klik w podgląd nie jest „klikiem w tło" (inaczej
      zamykałby cały detal). ── */
  }
  <div
    class="lb"
    data-lightbox
    data-overlay-panel
    data-overlay-nodrag
    role="region"
    aria-label="Podgląd pełnoekranowy galerii"
    tabindex="-1"
    hidden
  >
    <div class="lb-track" data-lb-track></div>
    <button
      class="lb-back"
      type="button"
      data-lb-close
      aria-label="Wróć do szczegółów realizacji"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M15 5l-7 7 7 7"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      class="lb-x"
      type="button"
      data-lb-close
      aria-label="Zamknij podgląd pełnoekranowy"
    >
      <i aria-hidden="true"><b></b><b></b></i>
    </button>
    <span class="lb-count lb-count--m" data-lb-count aria-hidden="true"></span>
    <div class="lb-bar">
      <span class="lb-nav">
        <button type="button" data-lb-prev aria-label="Poprzednie zdjęcie">
          <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
            <path
              d="M9.5 1L1.5 9l8 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </button>
        <button type="button" data-lb-next aria-label="Następne zdjęcie">
          <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
            <path
              d="M1.5 1l8 8-8 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </span>
      <span class="lb-side">
        <span class="lb-dashes" data-lb-dashes></span>
        <span class="lb-count" data-lb-count>01 / 01</span>
      </span>
    </div>
  </div>
  <div class="dt-projnav">
    <button
      class="dt-pn dt-pn--prev"
      type="button"
      data-prevproj
      aria-label="Poprzednia realizacja"
    >
      <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
        <path
          d="M9.5 1L1.5 9l8 8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <button
      class="dt-pn dt-pn--next"
      type="button"
      data-nextproj
      aria-label="Następna realizacja"
    >
      <svg viewBox="0 0 11 18" fill="none" aria-hidden="true">
        <path
          d="M1.5 1l8 8-8 8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  /* ── Wspólne: scrim + stany overlay.ts (is-open / is-closing) ── */
  .dt-ov {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    /* scrim sheeta (design): przyciemnienie + delikatny blur */
    background: rgba(24, 19, 14, 0.55);
    -webkit-backdrop-filter: blur(1.5px);
    backdrop-filter: blur(1.5px);
    opacity: 0;
    transition: opacity 0.34s ease;
  }
  .dt-ov[hidden] {
    display: none;
  }
  .dt-ov.is-open {
    opacity: 1;
  }

  /* ── Panel: mobile = bottom sheet 90 % na papierze (design) ──
     Papier także na SAMYM panelu (korekta Mateusza): pas z grabberem
     leży nad scrollerem dt-body, więc bez własnej tekstury świecił
     gołym kremem nad papierową treścią. Te same warstwy co dt-body
     (statyczne — panel nie scrolluje). */
  .dt {
    position: relative;
    width: 100%;
    height: 90%;
    background:
      linear-gradient(rgba(250, 247, 241, 0.8), rgba(250, 247, 241, 0.8)),
      url("../../../assets/paper-background.webp") top center / 100% auto
        repeat-y #faf7f1;
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -10px 40px rgba(24, 19, 14, 0.32);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateY(101%);
    transition: transform 0.38s cubic-bezier(0.32, 0.72, 0.24, 1);
  }
  .dt-ov.is-open .dt {
    transform: translateY(0);
  }
  /* Panel bywa programowo fokusowany przy otwarciu dotykiem (tabindex=-1) —
     bez pierścienia; to kontener, nie kontrolka. */
  .dt:focus {
    outline: none;
  }

  .dt-grab {
    flex: none;
    height: 30px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 9px;
    cursor: grab;
    touch-action: none;
  }
  .dt-grab span {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: rgba(33, 29, 24, 0.22);
  }

  /* X sheeta — kwadrat na papierze (design: 38 px, obrys) */
  .dt-xm {
    position: absolute;
    top: 16px;
    right: 14px;
    width: 38px;
    height: 38px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: rgba(236, 232, 221, 0.94);
    border: 1px solid rgba(33, 29, 24, 0.12);
    padding: 0;
    cursor: pointer;
  }
  .dt-xm:hover {
    background: #e3decf;
  }
  .dt-xm i {
    position: relative;
    width: 13px;
    height: 13px;
    display: block;
  }
  .dt-xm i b {
    position: absolute;
    top: 6px;
    left: 0;
    width: 13px;
    height: 1.6px;
    background: var(--ink);
  }
  .dt-xm i b:first-child {
    transform: rotate(45deg);
  }
  .dt-xm i b:last-child {
    transform: rotate(-45deg);
  }

  .dt-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    /* Papier pod CAŁĄ scrollowaną treścią (korekta Mateusza): duży skan
       jak na podstronie, zapętlony repeat-y. Eksport kładł warstwę
       absolute inset:0 w scrollerze — kryła tylko pierwszy ekran, niżej
       świeciła biel (wada makiety). background-attachment: local
       przypina tło do TREŚCI scrollera, więc maluje się na całej
       wysokości przewijania; „opacity .2" tekstury robi półprzezroczysta
       warstwa kremu nad nią (background nie ma własnego opacity). */
    background:
      linear-gradient(rgba(250, 247, 241, 0.8), rgba(250, 247, 241, 0.8)),
      url("../../../assets/paper-background.webp") top center / 100% auto
        repeat-y #faf7f1;
    background-attachment: local, local;
  }
  .dt-body::-webkit-scrollbar {
    display: none;
  }

  .dt-projnav {
    display: none;
  }

  /* ── Podgląd pełnoekranowy (chrome; slajdy stylizuje blok is:global) ── */
  .lb {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #000;
    overflow: hidden;
  }
  .lb[hidden] {
    display: none;
  }
  /* fokus programowy przy otwarciu idzie na kontener (nie na chevron —
     iOS rysowałby na nim pierścień); to region, nie kontrolka */
  .lb:focus {
    outline: none;
  }
  .lb-back {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .lb-back:hover {
    opacity: 0.7;
  }
  .lb-back svg {
    width: 24px;
    height: 24px;
  }
  .lb-x {
    display: none;
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .lb-x:hover {
    opacity: 0.7;
  }
  .lb-x i {
    position: relative;
    width: 20px;
    height: 20px;
    display: block;
  }
  .lb-x i b {
    position: absolute;
    top: 9px;
    left: 0;
    width: 20px;
    height: 1.5px;
    background: #fff;
  }
  .lb-x i b:first-child {
    transform: rotate(45deg);
  }
  .lb-x i b:last-child {
    transform: rotate(-45deg);
  }

  /* licznik mobile: stały dolny pas ekranu (E7a — kadr `contain` nie ma
     stałej krawędzi, do której dałoby się go przywiązać) */
  .lb-count {
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.18em;
    color: #fff;
  }
  .lb-count--m {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(16px, env(safe-area-inset-bottom));
    text-align: center;
    z-index: 2;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .lb-bar {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 26px;
  }
  .lb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lb-nav button {
    appearance: none;
    padding: 0;
    cursor: pointer;
    width: 52px;
    height: 52px;
    box-sizing: border-box;
    border: 1px solid rgba(245, 239, 227, 0.5);
    background: none;
    color: #f5efe3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.35s ease,
      background 0.3s ease;
  }
  .lb-nav button:hover {
    background: rgba(245, 239, 227, 0.16);
  }
  .lb-nav button[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  .lb-nav svg {
    width: 10px;
    height: 17px;
  }
  .lb-side {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lb-dashes {
    display: flex;
    gap: 6px;
  }

  /* ════ Desktop (≥1024): modal wyśrodkowany, kadr 57 % | treść ════ */
  @media (min-width: 1024px) {
    .dt-ov {
      display: block;
      /* tło pod modalem (eksport: papier .36 + atrament .216 + blur) —
         spłaszczone do jednej ciepłoszarej warstwy */
      background: rgba(155, 150, 141, 0.5);
      -webkit-backdrop-filter: blur(1.5px);
      backdrop-filter: blur(1.5px);
    }
    .dt {
      position: absolute;
      left: 50%;
      top: 50%;
      /* ≤ 92 vw ZAWSZE (założenie projnav): 100vw−180 < 92 vw poniżej
         2250 px szerokości, wyżej tnie cap 1260 px */
      width: min(1260px, max(720px, 100vw - 180px));
      height: 86vh;
      border-radius: 0;
      flex-direction: row;
      box-shadow: 0 24px 70px rgba(16, 12, 8, 0.45);
      opacity: 0;
      transform: translate(-50%, calc(-50% + 8px)) scale(1);
      transition:
        opacity 0.28s ease,
        transform 0.28s cubic-bezier(0.22, 0.7, 0.15, 1);
    }
    .dt-ov.is-open .dt {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    .dt-grab {
      display: none;
    }
    .dt-xm {
      display: none;
    }
    .dt-body {
      min-width: 0;
      order: 1;
    }

    /* podgląd pełnoekranowy: desktop = chevron znika, X + pasek
       (strzałki / dashes / licznik) na dole */
    .lb-back,
    .lb-count--m {
      display: none;
    }
    .lb-x {
      display: flex;
    }
    .lb-bar {
      display: flex;
    }

    .dt-projnav {
      display: block;
    }
    .dt-pn {
      appearance: none;
      padding: 0;
      cursor: pointer;
      position: fixed;
      top: 50%;
      z-index: 2;
      width: 52px;
      height: 52px;
      margin-top: -26px;
      box-sizing: border-box;
      border: 1px solid rgba(245, 239, 227, 0.5);
      background: rgba(245, 239, 227, 0.16);
      color: #f5efe3;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.2s ease,
        color 0.2s ease;
    }
    .dt-pn:hover {
      background: #e3decf;
      color: var(--ink);
    }
    .dt-pn--prev {
      left: 19px;
    }
    .dt-pn--next {
      right: 19px;
    }
    .dt-pn svg {
      width: 11px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-ov,
    .dt,
    .dt-pn {
      transition: none;
    }
  }
</style>

<style is:global>
  /* Slajdy podglądu pełnoekranowego tworzy open-detail.ts w runtime
     (klony kadrów galerii BEZ atrybutu scope Astro) — stąd is:global,
     zawężone do #work-detail. E7a: kadr = CAŁE zdjęcie/wideo
     `object-fit: contain` na czarnym pełnym ekranie — pion dostaje pasy
     po bokach, poziom góra/dół (filmy klienta bywają pion i poziom). */
  #work-detail .lb-track {
    display: flex;
    height: 100%;
  }
  #work-detail .lb-slide {
    flex: none;
    width: 100%;
    height: 100%;
    position: relative;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  #work-detail .lb-media {
    position: absolute;
    inset: 0;
  }
  #work-detail .lb-media img,
  #work-detail .lb-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* pełny podgląd pokazuje zdjęcie bez filtra galerii */
    filter: none;
  }
  /* badge czasu z klonu kadru nie ma sensu w podglądzie (pion różnych
     formatów) — chowamy, informacja żyje w galerii */
  #work-detail .lb-media .dt-time {
    display: none;
  }
  @media (max-width: 1023px) {
    #work-detail .lb-track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      /* pion zostaje dla gestu swipe-down zamykającego podgląd
         (pointer events w open-detail.ts) */
      touch-action: pan-x;
    }
    #work-detail .lb-track::-webkit-scrollbar {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    #work-detail .lb-track {
      overflow: visible;
      transition: transform 0.62s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  #work-detail .lb-dashes button {
    appearance: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 26px;
    height: 2px;
    background: rgba(255, 255, 255, 0.35);
    transition: background 0.35s ease;
  }
  #work-detail .lb-dashes button.on {
    background: #fff;
  }
  /* grający film chowa ikonkę kamery i badge „…, aby obejrzeć"
     (open-detail.ts toggluje klasę) — oba znaki mówią o tym samym
     geście, więc gasną i wracają RAZEM */
  #work-detail .lb-slide.is-playing [data-cam],
  #work-detail .lb-slide.is-playing [data-cam-hint] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #work-detail .lb-track,
    #work-detail .lb-dashes button {
      transition: none;
    }
  }
</style>
