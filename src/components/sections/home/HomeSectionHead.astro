---
// Trójka nagłówkowa sekcji strony głównej: h2 Garamond → lead italik →
// akapit. Eyebrow mono „NN · TYTUŁ" był w eksporcie, ale wypadł na
// życzenie klienta (sesja poprawek klienta) — razem z nim odeszły propy
// `num`/`label`. Style klas .s-* są GLOBALNE (index.astro); komponent
// tylko składa markup, a [data-rev] + kaskada [data-rev-d] to reveale
// mobile (home-motion.ts za bramką js-motion; desktop statyczny).
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---

<div class="shead">
  <h2 class="s-title" data-rev>{title}</h2>
  <p class="s-lead" data-rev data-rev-d="1">{lead}</p>
  <p class="s-body" data-rev data-rev-d="2"><slot /></p>
</div>
