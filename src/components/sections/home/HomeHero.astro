---
// Hero strony głównej (4.2, analiza §1): pełne logo EH/A + h1 + lead +
// dwa CTA + ryciny domów. [data-navref] = kontrakt Navbara 4.1 (stan
// „solid" od wysokości hero − 40 px). Hero wypełnia pierwszy ekran pod
// paskiem fixed: min-height 100svh − --hdr-h (świadomie svh, nie dvh —
// dvh rośnie przy zwijaniu paska Safari i szarpałoby treścią; H3).
// Logo = maska CSS na cache'owanym SVG (wzorzec znaczka z 4.1 — 34 KB
// wektora nie może siedzieć inline w HTML-u).
import logoFull from "@/assets/logo/eha-logo.svg";

import house1 from "@/assets/dom-ryc-house1.webp";
import house2 from "@/assets/dom-ryc-house2.webp";
import house3 from "@/assets/dom-ryc-house3.webp";
import house6 from "@/assets/dom-ryc-house6.webp";
import planRyc from "@/assets/plan-ryc1.webp";
import { CONTACT_PATH, WORK_INDEX_PATH } from "@/lib/routes";
---

<section class="hero" data-navref>
  <div class="hero-rycs" aria-hidden="true">
    {/* mobile: 4 ryciny z parallaxem (house3 użyty dwa razy — eksport) */}
    {
      /* Ryciny „rysują się" sekwencyjnie po wejściu (korekta Mateusza):
         data-ryc-auto = etap startu (0 s lewa → 1 s prawa górna →
         2 s obie przy dolnej krawędzi; delaye w CSS index.astro),
         home-motion.ts odpala je bez IntersectionObservera. */
    }
    <img
      class="mOnly hr-m1"
      data-plxr
      data-ryc="l"
      data-ryc-auto="0"
      src={house6.src}
      width={house6.width}
      height={house6.height}
      alt=""
      decoding="async"
    />
    <img
      class="mOnly hr-m2"
      data-plxr
      data-ryc="l"
      data-ryc-auto="2"
      src={house3.src}
      width={house3.width}
      height={house3.height}
      alt=""
      decoding="async"
    />
    <img
      class="mOnly hr-m3"
      data-plxr
      data-ryc="r"
      data-ryc-auto="2"
      src={house2.src}
      width={house2.width}
      height={house2.height}
      alt=""
      decoding="async"
    />
    <img
      class="mOnly hr-m4"
      data-plxr
      data-ryc="r"
      data-ryc-auto="1"
      src={house3.src}
      width={house3.width}
      height={house3.height}
      alt=""
      decoding="async"
    />
    {/* desktop: 3 ryciny statyczne + plan rysowany po dojechaniu scrolla */}
    <img
      class="dOnly hr-d1"
      src={house3.src}
      width={house3.width}
      height={house3.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="dOnly hr-d2"
      src={house1.src}
      width={house1.width}
      height={house1.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="dOnly hr-d3"
      src={house2.src}
      width={house2.width}
      height={house2.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="dOnly hr-plan"
      data-rycsb="l"
      src={planRyc.src}
      width={planRyc.width}
      height={planRyc.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="hero-in">
    <span
      class="hero-logo"
      role="img"
      aria-label="Pracownia EH/A"
      style={`--logo:url('${logoFull.src}');aspect-ratio:${logoFull.width}/${logoFull.height}`}
    ></span>
    <h1>Dom z historią zasługuje na spokojny remont.</h1>
    <p class="hero-lead">
      Ciesielstwo i murarstwo tradycyjne, tynki wapienne, wełna drzewna.
      Prowadzimy całą inwestycję — od ekspertyzy po stan surowy zamknięty +.
    </p>
    <div class="hero-cta">
      <a class="cta-fill" href={CONTACT_PATH}>Porozmawiajmy o Twoim domu</a>
      <a class="cta-line" href={WORK_INDEX_PATH}>Zobacz realizacje →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* pierwszy ekran pod paskiem fixed (main.home ma padding-top:--hdr-h);
       podłoga = eksportowe max(100vh,550) − pasek; --svh zamiast 100svh —
       przypinane przy ruchomym webview (home-viewport.ts, D-Q2) */
    min-height: max(calc(var(--svh) - var(--hdr-h)), 458px);
  }
  .hero-rycs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-rycs img {
    position: absolute;
    /* zapasy kadru wystają za krawędzie — preflight dławi je bez tego */
    max-width: none;
    height: auto;
    /* ryciny spłaszczone na biel (waga!) — papier przywraca multiply */
    mix-blend-mode: multiply;
  }
  .hr-m1 {
    left: -34px;
    top: 152px;
    width: clamp(95px, 13.6vw, 124px);
  }
  .hr-m2 {
    left: -30px;
    bottom: -92px;
    width: clamp(180px, 25.7vw, 232px);
  }
  .hr-m3 {
    right: -18px;
    bottom: -70px;
    width: clamp(120px, 17.1vw, 156px);
  }
  .hr-m4 {
    right: -1px;
    top: 90px;
    width: clamp(140px, 20vw, 182px);
  }

  .hero-in {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Mobile: treść opiera się o DOLNY margines pierwszego ekranu (CTA
       jak najniżej), a całą nadwyżkę wysokości wchłania logo — patrz
       .hero-logo. Desktop wraca do wyśrodkowania niżej. */
    justify-content: flex-end;
    text-align: center;
    padding: 24px var(--sp) 44px;
    gap: clamp(24px, 3.3vw, 34px);
  }
  .hero-logo {
    display: block;
    /* Korekta Mateusza (poprawki wizualne po 4.6): logo ma być TAK DUŻE,
       jak pozwala wolna przestrzeń pierwszego ekranu — małe na niskim
       telefonie, większe na wysokim (iPhone 15 Pro).
       Poprzednia wersja SZACOWAŁA wysokość reszty treści modelem
       liniowym (1208px − 190vw) wykalibrowanym na 390 i 375 px. Każde
       urządzenie odbiegające od modelu dostawało jednocześnie za małe
       logo i pustkę pod CTA (zgłoszone z iPhone'a 15 Pro), a górny cap
       `clamp(234px, 33vw, 300px)` przy szerokościach telefonów redukował
       się do PŁASKICH 234 px — więc logo i tak nie mogło urosnąć od
       wysokości ekranu.
       Teraz zamiast szacunku jest pomiar: logo to jedyny rosnący element
       kolumny (`flex: 1 1 0`), więc dostaje dokładnie tyle, ile zostało
       po h1, leadzie, CTA, gapach i paddingach — cokolwiek przeglądarka
       naprawdę zmierzy. Proporcje trzyma `aspect-ratio` (inline z SVG),
       więc szerokość wynika z wysokości. `min-height` chroni czytelność
       znaku (przy ujemnej nadwyżce hero rośnie ponad pierwszy ekran, jak
       poprzednio), `max-height` to cap rozmiaru projektowego.
       D-Q2 zostaje nienaruszone: wysokość hero dalej liczy się
       z przypinanego `--svh`, więc chowany pasek URL nie rusza logo. */
    flex: 1 1 0;
    width: auto;
    min-height: 80px;
    max-height: min(248px, 63vw);
    background: #4c3b2b; /* sepia logotypu z designu */
    -webkit-mask: var(--logo) no-repeat center / contain;
    mask: var(--logo) no-repeat center / contain;
  }
  .hero h1 {
    margin: 0;
    max-width: clamp(330px, 52vw, 560px);
    font-family: var(--font-serif), serif;
    font-weight: 500;
    font-size: clamp(34px, 4.9vw, 46px);
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .hero-lead {
    margin: 0;
    max-width: clamp(320px, 46vw, 470px);
    font-family: var(--font-body), sans-serif;
    font-size: clamp(15px, 2.1vw, 18px);
    line-height: 1.6;
    color: var(--faint);
  }
  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 4px;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .hero {
      min-height: max(calc(var(--svh) - var(--hdr-h)), 478px);
    }
    .hr-d1 {
      left: -3.9vw;
      bottom: -2.1vw;
      width: clamp(245px, 23.6vw, 378px);
    }
    .hr-d2 {
      right: -2.1vw;
      bottom: -1.7vw;
      width: clamp(160px, 15.6vw, 250px);
    }
    .hr-d3 {
      left: 21%;
      top: 65.7%;
      width: clamp(95px, 9vw, 144px);
    }
    .hr-plan {
      left: 45%;
      top: 112%;
      width: 380px;
      transform: translate(-50%, -50%);
      opacity: 0.24;
    }
    .hero-in {
      padding: clamp(40px, 4vw, 64px) var(--g) clamp(30px, 2.8vw, 44px);
      gap: clamp(18px, 1.81vw, 29px);
      /* desktop bez zmian: blok hero pozostaje wyśrodkowany w pionie
         (rosnące logo i kotwiczenie CTA to zachowanie mobilne) */
      justify-content: center;
    }
    .hero-logo {
      flex: none;
      width: clamp(230px, 22.2vw, 355px);
      min-height: 0;
      max-height: none;
    }
    .hero h1 {
      font-size: clamp(40px, 3.75vw, 60px);
      line-height: 1.14;
      max-width: clamp(590px, 56.9vw, 911px);
    }
    .hero-lead {
      font-size: clamp(14.5px, 1.18vw, 19px);
      line-height: var(--lh-b);
      max-width: clamp(430px, 41.7vw, 666px);
    }
    .hero-cta {
      flex-direction: row;
      gap: clamp(18px, 1.94vw, 31px);
      margin-top: 6px;
    }
  }
</style>
