---
// Fonty eha (E10; self-hosted przez Fontsource — lekcja FOUC/LCP; Google
// Fonts z eksportów designów NIE wchodzi do produkcji: FOUC + polityka
// prywatności deklaruje wyłącznie Cloudflare/Resend):
// — EB Garamond Variable: serif (nagłówki/cytaty; + oś italic),
// — IBM Plex Sans Variable: body/UI,
// — IBM Plex Mono: statyczne 400/500/600 (etykiety; brak wersji variable
//   w Fontsource — wynik testu A/B Etapu 0.4).
//
// ETAP 6 (audyt fontów): gotowe arkusze `index.css` krojów ZMIENNYCH
// wyleciały — deklaracje @font-face stoją teraz w src/styles/fonts.css,
// bo subsety `latin-ext` bierzemy własne (274 KB → 27 KB; uzasadnienie
// i pomiar w nagłówku fonts.css). Plex Mono ma w pakiecie wejścia per
// subset, więc jego `latin` dalej idzie gotowcem — bez `latin-ext`,
// który dokłada fonts.css.
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";

import "@/styles/fonts.css";
import "@/styles/global.css";

import LoadingOverlay from "@/components/ui/LoadingOverlay.astro";

// Preload krojów above-the-fold — skraca okno font-display:swap (mniejszy
// „przeskok" z fontu systemowego przy nawigacji). Import ?url zamiast
// hardkodu: hash pliku woff2 zmienia się co build. Strona jest PL-only,
// więc kryte są oba subsety (latin + latin-ext — polskie diakrytyki);
// od Etapu 6 `latin-ext` to NASZE subsety polskie (src/assets/fonts/),
// więc preload dwóch dodatkowych plików kosztuje razem 12,8 KB zamiast
// 145 KB. Italiki Garamonda i Plex Mono celowo BEZ preloadu: nie są
// krytyczne above-the-fold (dogrywają się swapem).
import garamondExtWoff2 from "@/assets/fonts/eb-garamond-latin-ext-wght-normal-pl.woff2?url";
import plexExtWoff2 from "@/assets/fonts/ibm-plex-sans-latin-ext-wght-normal-pl.woff2?url";
import garamondWoff2 from "@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url";
import plexWoff2 from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  lang?: string;
  /** Opcjonalny meta description (podstrony; strona główna go nie ustawia). */
  description?: string;
  /** Nadpisanie canonicala. W eha wszystkie trasy mają własny canonical
   *  (mobile 1:1 desktop, bez redirectów — §9 analizy); prop zostaje na
   *  wypadek przyszłych wyjątków. */
  canonicalPath?: string;
}
const {
  title = "Pracownia EH/A — remonty domów z historią",
  lang = "pl",
  description,
  canonicalPath,
} = Astro.props;

// Adresy absolutne dla podglądów linków (iMessage/Messenger/X wymagają pełnego URL).
// W dev bazą jest bieżący host (np. adres w sieci lokalnej), by podgląd linka
// działał przed deployem; w buildzie produkcyjnym — domena z astro.config.
// og-image.png = pełne logo EH/A na tle „papieru", kadr 1200×630 (napis
// niesie NAZWĘ firmy, sam znaczek nikomu jej nie powie; 1,91:1 to proporcje,
// których nie przycina Facebook/X/LinkedIn). Generowany przez
// `node scripts/make-icons.mjs` razem z kompletem ikon — nie podmieniaj
// ręcznie. Bez og:image komunikatory same wybierają przypadkowy duży
// obrazek ze strony.
const urlBase = import.meta.env.DEV ? Astro.url : Astro.site;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, urlBase);
const ogImageUrl = new URL("/og-image.png", urlBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      /* Kolor UI przeglądarki = papier strony (--bg z global.css).
         Białe #fff dawało na Androidzie BIAŁY pas przy zwijaniu paska
         URL (widoczny na Galaxy S20 FE — korekta Mateusza, Etap 4.2). */
    }
    <meta name="theme-color" content="#f5efe3" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Slot head — dla skryptów, które MUSZĄ odpalić przed paintem. */}
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={garamondWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={garamondExtWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={plexWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={plexExtWoff2}
      crossorigin
    />
    <script is:inline>
      // Mikro-fade przy nawigacji WEWNĘTRZNEJ (docs/visual-corrections-part1.md
      // pkt 8): pierwsza wizyta w karcie (brak flagi sessionStorage) renderuje
      // się bez żadnej bramki — zero wpływu na LCP (LHCI i Playwright wchodzą
      // na zimno). Przy kolejnych nawigacjach treść wjeżdża krótkim fade'em
      // zdejmowanym przez document.fonts.ready LUB twardy timeout 300 ms —
      // strona nigdy nie zostaje ukryta (błąd JS/brak JS = brak klasy
      // nav-fade, czyli domyślnie widoczna).
      (() => {
        try {
          const KEY = "hm:visited";
          const revisit = sessionStorage.getItem(KEY) === "1";
          sessionStorage.setItem(KEY, "1");
          if (!revisit) return;
          const root = document.documentElement;
          root.classList.add("nav-fade");
          const reveal = () => root.classList.add("fonts-in");
          setTimeout(reveal, 300);
          if (document.fonts && document.fonts.ready)
            document.fonts.ready.then(reveal, reveal);
        } catch {
          /* sessionStorage niedostępny (tryb prywatny) — bez fade */
        }
      })();
    </script>
    <style is:global>
      /* Bramka mikro-fade — patrz inline skrypt wyżej. Stan bazowy (bez
         .nav-fade) jest w pełni widoczny. */
      html.nav-fade body {
        opacity: 0;
      }
      html.nav-fade.fonts-in body {
        opacity: 1;
        transition: opacity 0.18s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        html.nav-fade.fonts-in body {
          transition: none;
        }
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pracownia-eha.pl" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Pracownia EH/A — remonty domów z historią"
    />
    <meta property="og:locale" content="pl_PL" />
    {
      /* summary_large_image, nie summary: przy kadrze 1,91:1 „summary"
         zredukowałby podgląd do miniaturki-kwadracika (D-E2). */
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <LoadingOverlay />
    <slot />
  </body>
</html>
